+package io.reactivex.rxjava3.internal.operators.observable;
+
+import static org.junit.Assert.*;
+
+import org.junit.Test;
+
+import io.reactivex.rxjava3.core.*;
+import io.reactivex.rxjava3.exceptions.TestException;
+import io.reactivex.rxjava3.functions.Function;
+import io.reactivex.rxjava3.observers.TestObserver;
+import io.reactivex.rxjava3.subjects.*;
+import io.reactivex.rxjava3.testsupport.TestHelper;
+
+public class ObservableSwitchMapDisposeTest extends RxJavaTest {
+
+    @Test
+    public void disposeBeforeInnerOnSubscribe() throws Throwable {
+        disposeBeforeInnerOnSubscribe(false);
+    }
+
+    @Test
+    public void disposeBeforeInnerOnSubscribeDelayError() throws Throwable {
+        disposeBeforeInnerOnSubscribe(true);
+    }
+
+    void disposeBeforeInnerOnSubscribe(boolean delayErrors) throws Throwable {
+        TestHelper.withErrorTracking(errors -> {
+            BehaviorSubject<Integer> outer = BehaviorSubject.createDefault(1);
+            PublishSubject<Integer> inner = PublishSubject.create();
+            TestObserver<Integer> to = new TestObserver<>();
+
+            Function<Integer, Observable<Integer>> mapper = v -> Observable.defer(() -> {
+                to.dispose();
+                return inner.scan(0, (a, b) -> a + b).map(w -> w);
+            });
+
+            Observable<Integer> result = delayErrors
+                    ? outer.switchMapDelayError(mapper) : outer.switchMap(mapper);
+            result.subscribe(to);
+
+            to.assertEmpty();
+            assertTrue(to.isDisposed());
+            assertFalse(outer.hasObservers());
+            assertFalse(inner.hasObservers());
+            assertTrue(errors.toString(), errors.isEmpty());
+        });
+    }
+
+    @Test
+    public void outerErrorBeforeInnerOnSubscribe() throws Throwable {
+        TestHelper.withErrorTracking(errors -> {
+            PublishSubject<Integer> outer = PublishSubject.create();
+            PublishSubject<Integer> inner = PublishSubject.create();
+
+            TestObserver<Integer> to = outer.switchMap(v -> Observable.defer(() -> {
+                outer.onError(new TestException());
+                return inner.scan(0, (a, b) -> a + b).map(w -> w);
+            })).test();
+
+            outer.onNext(1);
+
+            to.assertFailure(TestException.class);
+            assertFalse(outer.hasObservers());
+            assertFalse(inner.hasObservers());
+            assertTrue(errors.toString(), errors.isEmpty());
+        });
+    }
+
+    @Test
+    public void disposeInnerSubscribeRace() throws Throwable {
+        disposeInnerSubscribeRace(false);
+    }
+
+    @Test
+    public void disposeInnerSubscribeRaceDelayError() throws Throwable {
+        disposeInnerSubscribeRace(true);
+    }
+
+    void disposeInnerSubscribeRace(boolean delayErrors) throws Throwable {
+        TestHelper.withErrorTracking(errors -> {
+            for (int i = 0; i < TestHelper.RACE_DEFAULT_LOOPS; i++) {
+                PublishSubject<Integer> outer = PublishSubject.create();
+                PublishSubject<Integer> inner = PublishSubject.create();
+
+                Function<Integer, Observable<Integer>> mapper = v -> Observable.defer(() ->
+                        inner.scan(0, (a, b) -> a + b).map(w -> w));
+
+                Observable<Integer> result = delayErrors
+                        ? outer.switchMapDelayError(mapper) : outer.switchMap(mapper);
+                TestObserver<Integer> to = result.test();
+
+                TestHelper.race(() -> outer.onNext(1), to::dispose);
+
+                to.assertNoErrors().assertNotComplete();
+                assertTrue(to.isDisposed());
+                assertFalse(outer.hasObservers());
+                assertFalse(inner.hasObservers());
+            }
+            assertTrue(errors.toString(), errors.isEmpty());
+        });
+    }
+}
