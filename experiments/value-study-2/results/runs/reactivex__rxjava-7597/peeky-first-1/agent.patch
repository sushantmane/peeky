+package io.reactivex.rxjava3.internal.operators.observable;
+
+import static org.junit.Assert.*;
+
+import org.junit.Test;
+
+import io.reactivex.rxjava3.core.*;
+import io.reactivex.rxjava3.observers.TestObserver;
+import io.reactivex.rxjava3.subjects.PublishSubject;
+import io.reactivex.rxjava3.testsupport.TestHelper;
+
+public class ObservableSwitchMapCancellationTest extends RxJavaTest {
+
+    @Test
+    public void cancelBeforeInnerOnSubscribe() throws Throwable {
+        cancelBeforeInnerOnSubscribe(false);
+    }
+
+    @Test
+    public void cancelBeforeInnerOnSubscribeDelayError() throws Throwable {
+        cancelBeforeInnerOnSubscribe(true);
+    }
+
+    void cancelBeforeInnerOnSubscribe(boolean delayErrors) throws Throwable {
+        TestHelper.withErrorTracking(errors -> {
+            PublishSubject<Integer> refresh = PublishSubject.create();
+            PublishSubject<Integer> dimensions = PublishSubject.create();
+            TestObserver<Integer> to = new TestObserver<>();
+
+            Observable<Integer> inner = Observable.defer(() -> dimensions
+                    .scan(0, Integer::sum)
+                    .map(v -> v)
+                    .doOnSubscribe(d -> to.dispose()));
+
+            Observable<Integer> switched = delayErrors
+                    ? refresh.switchMapDelayError(v -> inner)
+                    : refresh.switchMap(v -> inner);
+            switched.subscribe(to);
+
+            refresh.onNext(1);
+
+            to.assertEmpty();
+            assertTrue(to.isDisposed());
+            assertFalse(refresh.hasObservers());
+            assertFalse(dimensions.hasObservers());
+            assertTrue(errors.toString(), errors.isEmpty());
+        });
+    }
+
+    @Test
+    public void cancelDuringInnerSubscriptionRace() throws Throwable {
+        cancelDuringInnerSubscriptionRace(false);
+    }
+
+    @Test
+    public void cancelDuringInnerSubscriptionRaceDelayError() throws Throwable {
+        cancelDuringInnerSubscriptionRace(true);
+    }
+
+    void cancelDuringInnerSubscriptionRace(boolean delayErrors) throws Throwable {
+        TestHelper.withErrorTracking(errors -> {
+            for (int i = 0; i < TestHelper.RACE_DEFAULT_LOOPS; i++) {
+                PublishSubject<Integer> refresh = PublishSubject.create();
+                PublishSubject<Integer> dimensions = PublishSubject.create();
+                Observable<Integer> inner = Observable.defer(() -> dimensions
+                        .scan(0, Integer::sum)
+                        .map(v -> v));
+
+                Observable<Integer> switched = delayErrors
+                        ? refresh.switchMapDelayError(v -> inner)
+                        : refresh.switchMap(v -> inner);
+                TestObserver<Integer> to = switched.test();
+
+                TestHelper.race(() -> refresh.onNext(1), to::dispose);
+
+                to.assertNoErrors().assertNotComplete();
+                assertTrue(to.values().size() <= 1);
+                if (!to.values().isEmpty()) {
+                    to.assertValue(0);
+                }
+                assertTrue(to.isDisposed());
+                assertFalse(refresh.hasObservers());
+                assertFalse(dimensions.hasObservers());
+                assertTrue(errors.toString(), errors.isEmpty());
+            }
+        });
+    }
+}
