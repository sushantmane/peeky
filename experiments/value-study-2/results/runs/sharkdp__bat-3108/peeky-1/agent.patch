+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn plain_paging_precedence() {
+        let cases: &[(&[&str], PagingMode)] = &[
+            (&["--plain"], PagingMode::QuitIfOneScreen),
+            (&["-pp"], PagingMode::Never),
+            (&["--paging=never", "--plain"], PagingMode::Never),
+            (&["--plain", "--paging=never"], PagingMode::Never),
+            (&["--paging=never", "-p"], PagingMode::Never),
+            (&["-p", "--paging=never"], PagingMode::Never),
+            (&["--paging=always", "--plain"], PagingMode::Always),
+            (&["--plain", "--paging=always"], PagingMode::Always),
+            (&["--paging=auto", "--plain"], PagingMode::QuitIfOneScreen),
+            (&["--plain", "--paging=auto"], PagingMode::QuitIfOneScreen),
+            (&["--paging=always", "-pp"], PagingMode::Never),
+            (&["-pp", "--paging=always"], PagingMode::Always),
+            (&["--paging=auto", "-pp"], PagingMode::Never),
+            (&["-pp", "--paging=auto"], PagingMode::QuitIfOneScreen),
+            (&["--plain", "--plain"], PagingMode::Never),
+            (&["--paging=always", "-p", "-p"], PagingMode::Never),
+            (&["-p", "-p", "--paging=always"], PagingMode::Always),
+            (&["-pp", "--paging=always", "-pp"], PagingMode::Never),
+            (&["--paging=always", "-pp", "--paging=always"], PagingMode::Always),
+            (&["-P", "--plain"], PagingMode::Never),
+            (&["--plain", "-P"], PagingMode::Never),
+        ];
+
+        for &(args, expected) in cases {
+            let app = App {
+                matches: clap_app::build_app(true)
+                    .get_matches_from(std::iter::once("bat").chain(args.iter().copied())),
+                interactive_output: true,
+            };
+            let config = app.config(&[]).unwrap();
+            assert_eq!(config.paging_mode, expected, "args: {args:?}");
+            assert!(config.style_components.plain(), "args: {args:?}");
+        }
+    }
+}
