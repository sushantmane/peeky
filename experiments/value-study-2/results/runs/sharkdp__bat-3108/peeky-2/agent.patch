+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn plain_and_paging_are_independent() {
+        for args in [
+            ["--paging=never", "--plain"],
+            ["--plain", "--paging=never"],
+            ["--paging=always", "--plain"],
+            ["--plain", "--paging=always"],
+        ] {
+            for interactive_output in [false, true] {
+                let app = App {
+                    matches: clap_app::build_app(interactive_output)
+                        .get_matches_from(["bat"].into_iter().chain(args)),
+                    interactive_output,
+                };
+                let config = app.config(&[]).unwrap();
+                let expected = if args.contains(&"--paging=always") {
+                    PagingMode::Always
+                } else {
+                    PagingMode::Never
+                };
+                assert_eq!(config.paging_mode, expected, "{args:?}");
+                assert!(config.style_components.plain(), "{args:?}");
+            }
+        }
+    }
+
+    #[test]
+    fn double_plain_respects_paging_order() {
+        for (args, expected) in [
+            (vec!["-p"], PagingMode::QuitIfOneScreen),
+            (vec!["-pp"], PagingMode::Never),
+            (vec!["--plain", "--plain"], PagingMode::Never),
+            (vec!["--paging=always", "-pp"], PagingMode::Never),
+            (vec!["-pp", "--paging=always"], PagingMode::Always),
+            (vec!["--paging=auto", "-pp"], PagingMode::Never),
+            (vec!["-pp", "--paging=auto"], PagingMode::QuitIfOneScreen),
+            (vec!["--paging=auto", "-p"], PagingMode::QuitIfOneScreen),
+            (vec!["-p", "--paging=auto"], PagingMode::QuitIfOneScreen),
+            (vec!["--paging=always", "--plain", "--plain"], PagingMode::Never),
+            (
+                vec!["--plain", "--plain", "--paging=always"],
+                PagingMode::Always,
+            ),
+            (
+                vec!["--paging=never", "-pp", "--paging=always"],
+                PagingMode::Always,
+            ),
+            (
+                vec!["--paging=always", "-pp", "--paging=auto"],
+                PagingMode::QuitIfOneScreen,
+            ),
+            (
+                vec!["-pp", "--paging=always", "--paging=auto"],
+                PagingMode::QuitIfOneScreen,
+            ),
+        ] {
+            let app = App {
+                matches: clap_app::build_app(true)
+                    .get_matches_from(["bat"].into_iter().chain(args.iter().copied())),
+                interactive_output: true,
+            };
+            let config = app.config(&[]).unwrap();
+            assert_eq!(config.paging_mode, expected, "{args:?}");
+            assert!(config.style_components.plain(), "{args:?}");
+        }
+    }
+}
