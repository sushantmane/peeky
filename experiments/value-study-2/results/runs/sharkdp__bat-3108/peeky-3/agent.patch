+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn paging_with_plain() {
+        for interactive_output in [true, false] {
+            for paging in [Some("never"), Some("always"), Some("auto"), None] {
+                for (plain, extra_plain) in [
+                    (&["-p"][..], false),
+                    (&["--plain"][..], false),
+                    (&["-pp"][..], true),
+                    (&["--plain", "--plain"][..], true),
+                ] {
+                    for paging_last in [false, true] {
+                        let mut args = vec!["bat".to_owned(), "test.txt".to_owned()];
+                        let paging_args = paging.map(|mode| format!("--paging={mode}"));
+                        if !paging_last {
+                            args.extend(paging_args.clone());
+                        }
+                        args.extend(plain.iter().map(|arg| (*arg).to_owned()));
+                        if paging_last {
+                            args.extend(paging_args);
+                        }
+
+                        let app = App {
+                            matches: clap_app::build_app(interactive_output).get_matches_from(&args),
+                            interactive_output,
+                        };
+                        let inputs = app.inputs().unwrap();
+                        let config = app.config(&inputs).unwrap();
+                        let expected = if extra_plain && (!paging_last || paging.is_none()) {
+                            PagingMode::Never
+                        } else {
+                            match paging {
+                                Some("always") => PagingMode::Always,
+                                Some("never") => PagingMode::Never,
+                                _ if interactive_output => PagingMode::QuitIfOneScreen,
+                                _ => PagingMode::Never,
+                            }
+                        };
+                        assert_eq!(config.paging_mode, expected, "{args:?}");
+                        assert!(config.style_components.plain(), "{args:?}");
+                    }
+                }
+            }
+        }
+    }
+}
