+++ b/docs/content/manual/manual.yml
@@ -407,6 +407,16 @@ sections:
           `.["foo"]` (`.foo` above is a shorthand version of this, but
           only for identifier-like strings).
 
+          When chaining bracket indexes, the separating dot is optional:
+          `.["foo"].["bar"]` and `.["foo"]["bar"]` are equivalent. This
+          also applies to array indexes, slices, and iteration, such as
+          `.foo.[0]`, `.foo.[1:3]`, and `.foo.[]`.
+
+        examples:
+          - program: '.["foo"].["bar"]'
+            input: '{"foo": {"bar": 42}}'
+            output: [42]
+
       - title: "Array Index: `.[<number>]`"
         body: |
 
