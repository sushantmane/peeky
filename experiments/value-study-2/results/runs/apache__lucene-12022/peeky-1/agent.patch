+  public void testCollapsedTriangleEdgeFlags() {
+    int x0 = encodeX(0);
+    int y0 = encodeY(0);
+    int x1 = encodeX(1);
+    int y1 = encodeY(1);
+    int[][] vertices = {
+      {x0, y0, x0, y0, x1, y1},
+      {x0, y0, x1, y1, x0, y0},
+      {x0, y0, x1, y1, x1, y1},
+      {x1, y1, x1, y1, x0, y0},
+      {x1, y1, x0, y0, x1, y1},
+      {x1, y1, x0, y0, x0, y0}
+    };
+    byte[] bytes = new byte[7 * ShapeField.BYTES];
+    ShapeField.DecodedTriangle triangle = new ShapeField.DecodedTriangle();
+    for (int[] v : vertices) {
+      for (int flags = 0; flags < 8; flags++) {
+        boolean ab = (flags & 1) != 0;
+        boolean bc = (flags & 2) != 0;
+        boolean ca = (flags & 4) != 0;
+        boolean expected =
+            (ab && (v[0] != v[2] || v[1] != v[3]))
+                || (bc && (v[2] != v[4] || v[3] != v[5]))
+                || (ca && (v[4] != v[0] || v[5] != v[1]));
+
+        triangle.setValues(v[0], v[1], ab, v[2], v[3], bc, v[4], v[5], ca);
+        ShapeField.resolveTriangleType(triangle);
+        assertEquals(ShapeField.DecodedTriangle.TYPE.LINE, triangle.type);
+        assertEquals(expected, triangle.ab);
+        assertEquals(triangle.aX, triangle.cX);
+        assertEquals(triangle.aY, triangle.cY);
+
+        ShapeField.encodeTriangle(bytes, v[1], v[0], ab, v[3], v[2], bc, v[5], v[4], ca);
+        ShapeField.decodeTriangle(bytes, triangle);
+        assertEquals(ShapeField.DecodedTriangle.TYPE.LINE, triangle.type);
+        assertEquals(expected, triangle.ab);
+        assertEquals(triangle.aX, triangle.cX);
+        assertEquals(triangle.aY, triangle.cY);
+      }
+    }
+  }
+
