+  public void testCollapsedTriangleEdgeFlags() {
+    int aX = encodeX(0);
+    int aY = encodeY(0);
+    int bX = encodeX(1);
+    int bY = encodeY(1);
+    for (int collapsedEdge = 0; collapsedEdge < 3; collapsedEdge++) {
+      for (int flags = 0; flags < 8; flags++) {
+        ShapeField.DecodedTriangle triangle = new ShapeField.DecodedTriangle();
+        triangle.setValues(
+            aX,
+            aY,
+            (flags & 1) != 0,
+            collapsedEdge == 0 ? aX : bX,
+            collapsedEdge == 0 ? aY : bY,
+            (flags & 2) != 0,
+            collapsedEdge == 2 ? aX : bX,
+            collapsedEdge == 2 ? aY : bY,
+            (flags & 4) != 0);
+        boolean fromShape = (flags & ~(1 << collapsedEdge)) != 0;
+        ShapeField.resolveTriangleType(triangle);
+        assertEquals(ShapeField.DecodedTriangle.TYPE.LINE, triangle.type);
+        assertEquals(aX, triangle.aX);
+        assertEquals(aY, triangle.aY);
+        assertEquals(bX, triangle.bX);
+        assertEquals(bY, triangle.bY);
+        assertEquals(aX, triangle.cX);
+        assertEquals(aY, triangle.cY);
+        assertEquals(fromShape, triangle.ab);
+      }
+    }
+  }
