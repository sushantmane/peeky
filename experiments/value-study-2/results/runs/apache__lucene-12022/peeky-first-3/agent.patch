+package org.apache.lucene.document;
+
+import org.apache.lucene.document.ShapeField.DecodedTriangle;
+import org.apache.lucene.document.ShapeField.QueryRelation;
+import org.apache.lucene.geo.Circle;
+import org.apache.lucene.geo.LatLonGeometry;
+import org.apache.lucene.geo.Line;
+import org.apache.lucene.geo.Polygon;
+import org.apache.lucene.geo.Rectangle;
+import org.apache.lucene.index.DirectoryReader;
+import org.apache.lucene.index.IndexWriter;
+import org.apache.lucene.search.IndexSearcher;
+import org.apache.lucene.store.Directory;
+import org.apache.lucene.tests.util.LuceneTestCase;
+
+public class TestShapeField extends LuceneTestCase {
+
+  public void testDegenerateTriangleBoundaryFlags() {
+    int[][] vertices = {
+      {0, 0, 0, 0, 10, 10},
+      {0, 0, 10, 10, 0, 0},
+      {0, 0, 10, 10, 10, 10}
+    };
+    int[] survivingEdgeMasks = {6, 3, 5};
+    byte[] bytes = new byte[7 * ShapeField.BYTES];
+    for (int collapsed = 0; collapsed < vertices.length; collapsed++) {
+      int[] v = vertices[collapsed];
+      for (int flags = 0; flags < 8; flags++) {
+        boolean ab = (flags & 1) != 0;
+        boolean bc = (flags & 2) != 0;
+        boolean ca = (flags & 4) != 0;
+        boolean expected = (flags & survivingEdgeMasks[collapsed]) != 0;
+        DecodedTriangle triangle = new DecodedTriangle();
+        triangle.setValues(v[0], v[1], ab, v[2], v[3], bc, v[4], v[5], ca);
+        ShapeField.resolveTriangleType(triangle);
+        assertEquals(DecodedTriangle.TYPE.LINE, triangle.type);
+        assertEquals(triangle.toString(), expected, triangle.ab);
+        assertEquals(triangle.aX, triangle.cX);
+        assertEquals(triangle.aY, triangle.cY);
+
+        ShapeField.encodeTriangle(bytes, v[1], v[0], ab, v[3], v[2], bc, v[5], v[4], ca);
+        ShapeField.decodeTriangle(bytes, triangle);
+        assertEquals(DecodedTriangle.TYPE.LINE, triangle.type);
+        assertEquals(triangle.toString(), expected, triangle.ab);
+      }
+    }
+  }
+
+  public void testContainsFlatPolygon() throws Exception {
+    Polygon polygon =
+        new Polygon(
+            new double[] {3, 2, 2.0000000002, 3, 3}, new double[] {2, 2, 2.0000000001, 3, 2});
+    LatLonGeometry[] crossingQueries = {
+      new Polygon(
+          new double[] {2.4, 2.4, 2.6, 2.6, 2.4}, new double[] {1.9, 2.1, 2.1, 1.9, 1.9}),
+      new Rectangle(2.4, 2.6, 1.9, 2.1),
+      new Line(new double[] {2.5, 2.5}, new double[] {1.9, 2.1}),
+      new Circle(2.5, 2, 10000)
+    };
+    try (Directory directory = newDirectory();
+        IndexWriter writer = new IndexWriter(directory, newIndexWriterConfig())) {
+      Document document = new Document();
+      for (Field field : LatLonShape.createIndexableFields("shape", polygon)) {
+        document.add(field);
+      }
+      writer.addDocument(document);
+      try (DirectoryReader reader = DirectoryReader.open(writer)) {
+        IndexSearcher searcher = newSearcher(reader);
+        for (LatLonGeometry query : crossingQueries) {
+          assertEquals(
+              1,
+              searcher.count(
+                  LatLonShape.newGeometryQuery("shape", QueryRelation.INTERSECTS, query)));
+          if (query instanceof Line == false) {
+            assertEquals(
+                0,
+                searcher.count(
+                    LatLonShape.newGeometryQuery("shape", QueryRelation.WITHIN, query)));
+          }
+          assertEquals(
+              0,
+              searcher.count(
+                  LatLonShape.newGeometryQuery("shape", QueryRelation.DISJOINT, query)));
+          assertEquals(
+              0,
+              searcher.count(
+                  LatLonShape.newGeometryQuery("shape", QueryRelation.CONTAINS, query)));
+        }
+        assertEquals(
+            0,
+            searcher.count(
+                LatLonShape.newBoxQuery("shape", QueryRelation.CONTAINS, 2.4, 2.6, 1.9, 2.1)));
+        Rectangle inside = new Rectangle(2.4, 2.6, 2.01, 2.1);
+        assertEquals(
+            1,
+            searcher.count(LatLonShape.newGeometryQuery("shape", QueryRelation.CONTAINS, inside)));
+        assertEquals(
+            1,
+            searcher.count(
+                LatLonShape.newBoxQuery("shape", QueryRelation.CONTAINS, 2.4, 2.6, 2.01, 2.1)));
+      }
+    }
+  }
