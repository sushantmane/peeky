+  public void testNarrowPolygonCloseToNorthPole() {
+    double minLat = decodeLatitude(Integer.MAX_VALUE - 3);
+    double maxLat = decodeLatitude(Integer.MAX_VALUE);
+    double minLon = decodeLongitude(Integer.MAX_VALUE - 3);
+    double maxLon = decodeLongitude(Integer.MAX_VALUE);
+    Polygon polygon =
+        new Polygon(
+            new double[] {minLat, minLat, maxLat, maxLat, minLat},
+            new double[] {minLon, maxLon, maxLon, minLon, minLon});
+    Component2D component = LatLonGeometry.create(polygon);
+    GeoEncodingUtils.Component2DPredicate predicate =
+        GeoEncodingUtils.createComponentPredicate(component);
+
+    assertTrue(predicate.test(Integer.MAX_VALUE - 2, Integer.MAX_VALUE - 2));
+    for (int latOffset = 0; latOffset <= 5; latOffset++) {
+      for (int lonOffset = 0; lonOffset <= 5; lonOffset++) {
+        int lat = Integer.MAX_VALUE - latOffset;
+        int lon = Integer.MAX_VALUE - lonOffset;
+        assertEquals(
+            component.contains(decodeLongitude(lon), decodeLatitude(lat)),
+            predicate.test(lat, lon));
+      }
+    }
+    assertFalse(predicate.test(Integer.MIN_VALUE, Integer.MAX_VALUE));
+  }
+
+  public void testSmallDistanceCloseToNorthPole() {
+    double radiusMeters = 0.01;
+    GeoEncodingUtils.DistancePredicate predicate =
+        GeoEncodingUtils.createDistancePredicate(90, 0, radiusMeters);
+
+    assertTrue(predicate.test(Integer.MAX_VALUE - 1, 0));
+    for (int latOffset = 0; latOffset <= 8; latOffset++) {
+      int lat = Integer.MAX_VALUE - latOffset;
+      for (int lon : new int[] {Integer.MIN_VALUE, 0, Integer.MAX_VALUE}) {
+        assertEquals(
+            SloppyMath.haversinMeters(90, 0, decodeLatitude(lat), decodeLongitude(lon))
+                <= radiusMeters,
+            predicate.test(lat, lon));
+      }
+    }
+    assertFalse(predicate.test(Integer.MIN_VALUE, 0));
+  }
