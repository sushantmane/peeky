+  public void testComponentPredicateNearPoles() {
+    for (int minLat : new int[] {Integer.MIN_VALUE, -2, Integer.MAX_VALUE - 3}) {
+      for (int minLon : new int[] {Integer.MIN_VALUE, -2, Integer.MAX_VALUE - 3}) {
+        double minY = decodeLatitude(minLat);
+        double maxY = decodeLatitude(minLat + 3);
+        double minX = decodeLongitude(minLon);
+        double maxX = decodeLongitude(minLon + 3);
+        Component2D component =
+            LatLonGeometry.create(
+                new Polygon(
+                    new double[] {minY, minY, maxY, maxY, minY},
+                    new double[] {minX, maxX, maxX, minX, minX}));
+        GeoEncodingUtils.Component2DPredicate predicate =
+            GeoEncodingUtils.createComponentPredicate(component);
+        assertTrue(predicate.test(minLat + 1, minLon + 1));
+        for (long lat = (long) minLat - 1; lat <= (long) minLat + 4; lat++) {
+          if (lat < Integer.MIN_VALUE || lat > Integer.MAX_VALUE) {
+            continue;
+          }
+          for (long lon = (long) minLon - 1; lon <= (long) minLon + 4; lon++) {
+            if (lon < Integer.MIN_VALUE || lon > Integer.MAX_VALUE) {
+              continue;
+            }
+            assertEquals(
+                component.contains(decodeLongitude((int) lon), decodeLatitude((int) lat)),
+                predicate.test((int) lat, (int) lon));
+          }
+        }
+      }
+    }
+  }
