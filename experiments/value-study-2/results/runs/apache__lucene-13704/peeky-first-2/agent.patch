+  public void testDistancePredicateNearPoles() {
+    for (int centerLat : new int[] {Integer.MIN_VALUE + 2, Integer.MAX_VALUE - 2}) {
+      for (int centerLon : new int[] {Integer.MIN_VALUE + 2, 0, Integer.MAX_VALUE - 2}) {
+        double lat = decodeLatitude(centerLat);
+        double lon = decodeLongitude(centerLon);
+        for (double radius : new double[] {0, 0.01, 1}) {
+          GeoEncodingUtils.DistancePredicate predicate =
+              GeoEncodingUtils.createDistancePredicate(lat, lon, radius);
+          assertTrue(predicate.test(centerLat, centerLon));
+          double distanceKey = GeoUtils.distanceQuerySortKey(radius);
+          for (int offset = -2; offset <= 2; offset++) {
+            int pointLat = centerLat + offset;
+            assertEquals(
+                SloppyMath.haversinSortKey(decodeLatitude(pointLat), lon, lat, lon) <= distanceKey,
+                predicate.test(pointLat, centerLon));
+          }
+        }
+      }
+    }
+  }
