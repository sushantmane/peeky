+  public void testNarrowPolygonPredicateAtEncodingBoundaries() {
+    int[] minima = {Integer.MIN_VALUE, -2, Integer.MAX_VALUE - 4, Integer.MAX_VALUE - 3};
+    for (int minLat : minima) {
+      for (int minLon : minima) {
+        double minLatitude = decodeLatitude(minLat);
+        double maxLatitude = decodeLatitude(minLat + 3);
+        double minLongitude = decodeLongitude(minLon);
+        double maxLongitude = decodeLongitude(minLon + 3);
+        Component2D component =
+            LatLonGeometry.create(
+                new Polygon(
+                    new double[] {minLatitude, minLatitude, maxLatitude, maxLatitude, minLatitude},
+                    new double[] {
+                      minLongitude, maxLongitude, maxLongitude, minLongitude, minLongitude
+                    }));
+        GeoEncodingUtils.Component2DPredicate predicate =
+            GeoEncodingUtils.createComponentPredicate(component);
+        assertTrue(component.contains(decodeLongitude(minLon + 1), decodeLatitude(minLat + 1)));
+        for (long lat = Math.max(Integer.MIN_VALUE, (long) minLat - 1);
+            lat <= Math.min(Integer.MAX_VALUE, (long) minLat + 4);
+            lat++) {
+          for (long lon = Math.max(Integer.MIN_VALUE, (long) minLon - 1);
+              lon <= Math.min(Integer.MAX_VALUE, (long) minLon + 4);
+              lon++) {
+            assertEquals(
+                "lat=" + lat + ", lon=" + lon,
+                component.contains(decodeLongitude((int) lon), decodeLatitude((int) lat)),
+                predicate.test((int) lat, (int) lon));
+          }
+        }
+      }
+    }
+  }
+
+  public void testDistancePredicateNearNorthPole() {
+    int latitude = Integer.MAX_VALUE - 2;
+    for (int longitude : new int[] {Integer.MIN_VALUE, 0, Integer.MAX_VALUE - 2}) {
+      double lat = decodeLatitude(latitude);
+      double lon = decodeLongitude(longitude);
+      for (double radius : new double[] {0.01, 0.1, 1.0, 10.0}) {
+        GeoEncodingUtils.DistancePredicate predicate =
+            GeoEncodingUtils.createDistancePredicate(lat, lon, radius);
+        assertTrue(predicate.test(latitude, longitude));
+        double distanceKey = GeoUtils.distanceQuerySortKey(radius);
+        for (int pointLat :
+            new int[] {
+              Integer.MIN_VALUE, 0, Integer.MAX_VALUE - 100, latitude, Integer.MAX_VALUE
+            }) {
+          for (int pointLon : new int[] {Integer.MIN_VALUE, 0, longitude, Integer.MAX_VALUE}) {
+            assertEquals(
+                SloppyMath.haversinSortKey(
+                        decodeLatitude(pointLat), decodeLongitude(pointLon), lat, lon)
+                    <= distanceKey,
+                predicate.test(pointLat, pointLon));
+          }
+        }
+      }
+    }
+  }
