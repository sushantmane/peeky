+package org.apache.lucene.document;
+
+import org.apache.lucene.document.ShapeField.QueryRelation;
+import org.apache.lucene.geo.GeoEncodingUtils;
+import org.apache.lucene.geo.Polygon;
+import org.apache.lucene.index.DirectoryReader;
+import org.apache.lucene.index.IndexWriter;
+import org.apache.lucene.index.SerialMergeScheduler;
+import org.apache.lucene.search.IndexSearcher;
+import org.apache.lucene.store.Directory;
+import org.apache.lucene.tests.util.LuceneTestCase;
+
+public class TestLatLonDocValuesQueries extends LuceneTestCase {
+
+  public void testNarrowPolygonCloseToNorthPole() throws Exception {
+    double latitude = GeoEncodingUtils.decodeLatitude(Integer.MAX_VALUE - 2);
+    double longitude = GeoEncodingUtils.decodeLongitude(Integer.MAX_VALUE - 2);
+    double minLat = GeoEncodingUtils.decodeLatitude(Integer.MAX_VALUE - 3);
+    double maxLat = GeoEncodingUtils.decodeLatitude(Integer.MAX_VALUE);
+    double minLon = GeoEncodingUtils.decodeLongitude(Integer.MAX_VALUE - 3);
+    double maxLon = GeoEncodingUtils.decodeLongitude(Integer.MAX_VALUE);
+    Polygon polygon =
+        new Polygon(
+            new double[] {minLat, minLat, maxLat, maxLat, minLat},
+            new double[] {minLon, maxLon, maxLon, minLon, minLon});
+
+    try (Directory directory = newDirectory();
+        IndexWriter writer =
+            new IndexWriter(
+                directory, newIndexWriterConfig().setMergeScheduler(new SerialMergeScheduler()))) {
+      Document document = new Document();
+      document.add(new LatLonDocValuesField("point", latitude, longitude));
+      document.add(new LatLonPoint("point", latitude, longitude));
+      writer.addDocument(document);
+      writer.flush();
+
+      try (DirectoryReader reader = DirectoryReader.open(writer)) {
+        IndexSearcher searcher = newSearcher(reader);
+        assertEquals(1, searcher.count(LatLonPoint.newPolygonQuery("point", polygon)));
+        assertEquals(1, searcher.count(LatLonDocValuesField.newSlowPolygonQuery("point", polygon)));
+        assertEquals(
+            1,
+            searcher.count(
+                LatLonDocValuesField.newSlowGeometryQuery("point", QueryRelation.WITHIN, polygon)));
+        assertEquals(
+            0,
+            searcher.count(
+                LatLonDocValuesField.newSlowGeometryQuery(
+                    "point", QueryRelation.DISJOINT, polygon)));
+        assertEquals(
+            1,
+            searcher.count(
+                LatLonDocValuesField.newSlowDistanceQuery("point", latitude, longitude, 0.001)));
+      }
+    }
+  }
+}
