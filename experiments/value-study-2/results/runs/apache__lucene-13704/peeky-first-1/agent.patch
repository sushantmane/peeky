+package org.apache.lucene.geo;
+
+import static org.apache.lucene.geo.GeoEncodingUtils.decodeLatitude;
+import static org.apache.lucene.geo.GeoEncodingUtils.decodeLongitude;
+
+import org.apache.lucene.tests.util.LuceneTestCase;
+
+public class TestGeoEncodingUtilsPredicates extends LuceneTestCase {
+
+  public void testComponentPredicateNearPoles() {
+    for (int width : new int[] {1, 3, 63, 127}) {
+      for (int minLat : new int[] {Integer.MIN_VALUE, Integer.MAX_VALUE - width}) {
+        for (int minLon : new int[] {Integer.MIN_VALUE, 0, Integer.MAX_VALUE - width}) {
+          double south = decodeLatitude(minLat);
+          double north = decodeLatitude(minLat + width);
+          double west = decodeLongitude(minLon);
+          double east = decodeLongitude(minLon + width);
+          Component2D tree =
+              LatLonGeometry.create(
+                  new Polygon(
+                      new double[] {south, south, north, north, south},
+                      new double[] {west, east, east, west, west}));
+          GeoEncodingUtils.Component2DPredicate predicate =
+              GeoEncodingUtils.createComponentPredicate(tree);
+          for (int latOffset : new int[] {-1, 0, width / 2, width, width + 1}) {
+            long lat = (long) minLat + latOffset;
+            if (lat < Integer.MIN_VALUE || lat > Integer.MAX_VALUE) {
+              continue;
+            }
+            for (int lonOffset : new int[] {-1, 0, width / 2, width, width + 1}) {
+              long lon = (long) minLon + lonOffset;
+              if (lon < Integer.MIN_VALUE || lon > Integer.MAX_VALUE) {
+                continue;
+              }
+              assertEquals(
+                  tree.contains(decodeLongitude((int) lon), decodeLatitude((int) lat)),
+                  predicate.test((int) lat, (int) lon));
+            }
+          }
+        }
+      }
+    }
+  }
+
+  public void testDistancePredicateNearPoles() {
+    for (int lat :
+        new int[] {
+          Integer.MIN_VALUE, Integer.MIN_VALUE + 2, Integer.MAX_VALUE - 2, Integer.MAX_VALUE
+        }) {
+      for (int lon : new int[] {Integer.MIN_VALUE, 0, Integer.MAX_VALUE}) {
+        for (double radius : new double[] {0, 0.001, 0.1}) {
+          GeoEncodingUtils.DistancePredicate predicate =
+              GeoEncodingUtils.createDistancePredicate(
+                  decodeLatitude(lat), decodeLongitude(lon), radius);
+          assertTrue(predicate.test(lat, lon));
+          assertFalse(predicate.test(0, lon));
+        }
+      }
+    }
+  }
+}
