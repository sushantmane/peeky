+  public void testComponentPredicateAtExtremeCoordinates() {
+    for (int minLat : new int[] {Integer.MIN_VALUE, -2, Integer.MAX_VALUE - 3}) {
+      for (int minLon : new int[] {Integer.MIN_VALUE, -2, Integer.MAX_VALUE - 3}) {
+        int maxLat = minLat + 3;
+        int maxLon = minLon + 3;
+        double minY = decodeLatitude(minLat);
+        double maxY = decodeLatitude(maxLat);
+        double minX = decodeLongitude(minLon);
+        double maxX = decodeLongitude(maxLon);
+        Polygon polygon =
+            new Polygon(
+                new double[] {minY, minY, maxY, maxY, minY},
+                new double[] {minX, maxX, maxX, minX, minX});
+        GeoEncodingUtils.Component2DPredicate predicate =
+            GeoEncodingUtils.createComponentPredicate(LatLonGeometry.create(polygon));
+        for (int i = 0; i <= 3; i++) {
+          for (int j = 0; j <= 3; j++) {
+            assertTrue(predicate.test(minLat + i, minLon + j));
+          }
+        }
+        if (minLat > Integer.MIN_VALUE) {
+          assertFalse(predicate.test(minLat - 1, minLon));
+        }
+        if (maxLat < Integer.MAX_VALUE) {
+          assertFalse(predicate.test(maxLat + 1, minLon));
+        }
+        if (minLon > Integer.MIN_VALUE) {
+          assertFalse(predicate.test(minLat, minLon - 1));
+        }
+        if (maxLon < Integer.MAX_VALUE) {
+          assertFalse(predicate.test(minLat, maxLon + 1));
+        }
+      }
+    }
+  }
+
+  public void testDistancePredicateAtNorthPole() {
+    int lat = Integer.MAX_VALUE - 2;
+    for (int lon : new int[] {Integer.MIN_VALUE, 0, Integer.MAX_VALUE}) {
+      GeoEncodingUtils.DistancePredicate predicate =
+          GeoEncodingUtils.createDistancePredicate(decodeLatitude(lat), decodeLongitude(lon), 0.01);
+      assertTrue(predicate.test(lat, lon));
+      assertFalse(predicate.test(encodeLatitude(89), lon));
+    }
+  }
