+  public void testComponentPredicateNearNorthPole() {
+    double minLat = decodeLatitude(Integer.MAX_VALUE - 3);
+    double maxLat = decodeLatitude(Integer.MAX_VALUE);
+    for (int minLon : new int[] {Integer.MIN_VALUE, 0, Integer.MAX_VALUE - 3}) {
+      double minLongitude = decodeLongitude(minLon);
+      double maxLongitude = decodeLongitude(minLon + 3);
+      Polygon polygon =
+          new Polygon(
+              new double[] {minLat, minLat, maxLat, maxLat, minLat},
+              new double[] {minLongitude, maxLongitude, maxLongitude, minLongitude, minLongitude});
+      GeoEncodingUtils.Component2DPredicate predicate =
+          GeoEncodingUtils.createComponentPredicate(LatLonGeometry.create(polygon));
+      assertTrue(predicate.test(Integer.MAX_VALUE - 2, minLon + 1));
+      assertTrue(predicate.test(Integer.MAX_VALUE, minLon + 3));
+      assertFalse(predicate.test(Integer.MAX_VALUE - 4, minLon + 1));
+      assertFalse(predicate.test(0, minLon + 1));
+    }
+  }
+
+  public void testDistancePredicateNearNorthPole() {
+    int lat = Integer.MAX_VALUE - 2;
+    int lon = Integer.MAX_VALUE - 2;
+    GeoEncodingUtils.DistancePredicate predicate =
+        GeoEncodingUtils.createDistancePredicate(decodeLatitude(lat), decodeLongitude(lon), 0.01);
+    assertTrue(predicate.test(lat, lon));
+    assertTrue(predicate.test(Integer.MAX_VALUE, lon));
+    assertFalse(predicate.test(Integer.MAX_VALUE - 100, lon));
+    assertFalse(predicate.test(0, lon));
+  }
