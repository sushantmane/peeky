 ### v1.18.25 "Edgy Guinea Pig"
-* No new changes since the release of v1.18.24
+* BUGFIX: `@UtilityClass` no longer causes a javac `NullPointerException` when generic methods and overloaded methods reference an inner class.
 
 ### v1.18.24 (April 18th, 2022)
 
diff --git a/src/core/lombok/javac/handlers/HandleUtilityClass.java b/src/core/lombok/javac/handlers/HandleUtilityClass.java
index 716d6d63..6a1affc3 100644
--- a/src/core/lombok/javac/handlers/HandleUtilityClass.java
+++ b/src/core/lombok/javac/handlers/HandleUtilityClass.java
@@ -131,6 +131,10 @@ public class HandleUtilityClass extends JavacAnnotationHandler<UtilityClass> {
 				if (innerClassSymbol != null && innerClassSymbol.type instanceof ClassType) {
 					((ClassType) innerClassSymbol.type).setEnclosingType(Type.noType);
 				}
+				// The erased type may already have been cached before the class was made static.
+				if (innerClassSymbol != null && innerClassSymbol.erasure_field instanceof ClassType) {
+					((ClassType) innerClassSymbol.erasure_field).setEnclosingType(Type.noType);
+				}
 			}
 		}
 		
