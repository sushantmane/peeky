@@ -0,0 +1,87 @@
+# Finally blocks need space for both the unwind value and its sentinel.
+
+
+class IDGenerator:
+    def __init__(self, max_id: int):
+        self._i = 0
+        self._mi = max_id
+
+    def get(self):
+        try:
+            return self._i
+        finally:
+            self._i += 1
+            if self._i > self._mi:
+                self._i = 0
+
+    def get_with_except(self, fail):
+        try:
+            if fail:
+                raise ValueError
+        except ValueError:
+            return self._i
+        else:
+            return self._i
+        finally:
+            self._i = max(self._i, self._mi, 2, 3, 4, 5)
+
+    def get_nested(self):
+        try:
+            return self._i
+        finally:
+            try:
+                self._i += 1
+            finally:
+                self._mi = max(self._mi, self._i, 2, 3, 4, 5)
+
+
+gen = IDGenerator(10)
+for _ in range(13):
+    print(gen.get())
+print(gen._i)
+
+gen = IDGenerator(10)
+print(gen.get_with_except(False), gen._i, gen._mi)
+print(gen.get_with_except(True), gen._i, gen._mi)
+
+gen = IDGenerator(10)
+print(gen.get_nested(), gen._i, gen._mi)
+
+
+def unwind_jump(gen, stop):
+    while gen._i < 2:
+        try:
+            if stop:
+                break
+            continue
+        finally:
+            gen._i += 1
+            gen._mi = max(gen._mi, gen._i, 2, 3, 4, 5)
+    return gen._i, gen._mi
+
+
+print(unwind_jump(IDGenerator(10), False))
+print(unwind_jump(IDGenerator(10), True))
+
+
+def fallthrough(gen):
+    try:
+        gen._i = 1
+    finally:
+        gen._mi = max(gen._mi, gen._i, 2, 3, 4, 5)
+    return gen._i, gen._mi
+
+
+def exception(gen):
+    try:
+        raise ValueError
+    finally:
+        gen._mi = max(gen._mi, gen._i, 2, 3, 4, 5)
+
+
+print(fallthrough(IDGenerator(10)))
+gen = IDGenerator(10)
+try:
+    exception(gen)
+except ValueError:
+    print(gen._i, gen._mi)
