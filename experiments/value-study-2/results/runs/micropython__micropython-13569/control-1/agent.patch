diff --git a/tests/basics/try_finally_stack.py b/tests/basics/try_finally_stack.py
new file mode 100644
index 000000000..12cda940b
--- /dev/null
+++ b/tests/basics/try_finally_stack.py
@@ -0,0 +1,67 @@
+# A pending return needs an extra stack slot while executing the finally block.
+class IDGenerator:
+    def __init__(self, max_id: int):
+        self._i = 0
+        self._mi = max_id
+
+    def get(self):
+        try:
+            return self._i
+        finally:
+            self._i += 1
+            if self._i > self._mi:
+                self._i = 0
+
+    def get_except(self):
+        try:
+            return self._i
+        except ValueError:
+            pass
+        finally:
+            self.values = (0, 1, 2, 3, 4, 5, 6, 7, self._i, self)
+
+    def get_nested(self):
+        try:
+            return self._i
+        finally:
+            try:
+                pass
+            finally:
+                self._i += 1
+                if self._i > self._mi:
+                    self._i = 0
+
+
+id_gen = IDGenerator(10)
+for _ in range(13):
+    print(id_gen.get(), id_gen._i)
+print(id_gen.get_except(), id_gen.values[:-1], id_gen.values[-1] is id_gen)
+for _ in range(13):
+    print(id_gen.get_nested(), id_gen._i)
+
+
+# Exercise a deeper finally stack on fallthrough, return, exception and jump.
+def f(mode):
+    value = 42
+    while True:
+        try:
+            if mode == 1:
+                return value
+            if mode == 2:
+                raise ValueError
+            if mode == 3:
+                break
+            if mode == 4:
+                mode = 0
+                continue
+        finally:
+            print(0, 1, 2, 3, 4, 5, 6, 7, value)
+        break
+    return value
+
+
+for mode in range(5):
+    try:
+        print(f(mode))
+    except ValueError:
+        print("ValueError")
