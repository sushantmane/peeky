@@ -0,0 +1,93 @@
+# Finally bodies must have room for a pending return value or jump destination.
+class IDGenerator:
+    def __init__(self, max_id: int):
+        self._i = 0
+        self._mi = max_id
+
+    def get(self):
+        try:
+            return self._i
+        finally:
+            self._i += 1
+            if self._i > self._mi:
+                self._i = 0
+
+    def get_except(self, fail):
+        try:
+            if fail:
+                raise ValueError
+            return self._i
+        except ValueError:
+            return self._i
+        finally:
+            self._i += 1
+            if self._i > self._mi:
+                self._i = 0
+
+    def get_nested(self):
+        try:
+            return self._i
+        finally:
+            try:
+                return self._i
+            finally:
+                self._i += 1
+                if self._i > self._mi:
+                    self._i = 0
+
+    def advance(self, stop):
+        while True:
+            try:
+                if stop:
+                    break
+                stop = True
+                continue
+            finally:
+                self._i += 1
+                if self._i > self._mi:
+                    self._i = 0
+
+
+id_gen = IDGenerator(10)
+for _ in range(13):
+    print(id_gen.get(), id_gen._i)
+
+id_gen = IDGenerator(2)
+for _ in range(4):
+    print(id_gen.get_except(False), id_gen._i)
+    print(id_gen.get_except(True), id_gen._i)
+
+id_gen = IDGenerator(2)
+for _ in range(4):
+    print(id_gen.get_nested(), id_gen._i)
+
+id_gen = IDGenerator(2)
+for stop in (True, False, True, False):
+    id_gen.advance(stop)
+    print(id_gen._i)
+
+
+# Exercise a deeper expression stack, not just augmented attribute assignment.
+def combine(a, b, c, d, e, f):
+    return a + b + c + d + e + f
+
+
+def deep(value):
+    try:
+        return value
+    finally:
+        print(combine(value, value, value, value, value, value), value)
+
+
+def nested(value):
+    try:
+        return value
+    finally:
+        try:
+            pass
+        finally:
+            print(combine(value, value, value, value, value, value), value)
+
+
+print(deep(7))
+print(nested(8))
