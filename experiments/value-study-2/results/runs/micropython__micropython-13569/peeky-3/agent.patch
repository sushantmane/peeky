diff --git a/tests/basics/try_finally_return6.py b/tests/basics/try_finally_return6.py
new file mode 100644
index 000000000..487e463a6
--- /dev/null
+++ b/tests/basics/try_finally_return6.py
@@ -0,0 +1,49 @@
+# A pending return needs an extra stack slot throughout the finally block.
+
+
+class IDGenerator:
+    def __init__(self, max_id: int):
+        self._i = 0
+        self._mi = max_id
+
+    def get(self):
+        try:
+            return self._i
+        finally:
+            self._i += 1
+            if self._i > self._mi:
+                self._i = 0
+
+    def get_except(self):
+        try:
+            return self._i
+        except ValueError:
+            pass
+        finally:
+            self._i += max(0, 0, 0, 1)
+            if self._i > self._mi:
+                self._i = 0
+
+    def get_nested(self):
+        try:
+            return self._i
+        finally:
+            try:
+                self._i += 1
+            finally:
+                self._i += max(0, 0, 0, 1)
+                if self._i > self._mi:
+                    self._i = 0
+
+
+id_gen = IDGenerator(10)
+for _ in range(14):
+    print(id_gen.get(), id_gen._i)
+
+id_gen = IDGenerator(10)
+for _ in range(14):
+    print(id_gen.get_except(), id_gen._i)
+
+id_gen = IDGenerator(10)
+for _ in range(8):
+    print(id_gen.get_nested(), id_gen._i)
