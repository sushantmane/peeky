diff --git a/py/compile.c b/py/compile.c
index 4f91ca49b..367c96138 100644
--- a/py/compile.c
+++ b/py/compile.c
@@ -1684,7 +1684,15 @@ STATIC void compile_try_finally(compiler_t *comp, mp_parse_node_t pn_body, int n
     }
     EMIT_ARG(load_const_tok, MP_TOKEN_KW_NONE);
     EMIT_ARG(label_assign, l_finally_block);
+    // The bytecode VM's unwind state has two stack entries, instead of just None
+    // or an exception. Account for the extra entry while compiling the finally body.
+    if (comp->scope_cur->emit_options <= MP_EMIT_OPT_BYTECODE) {
+        EMIT_ARG(adjust_stack_size, 1);
+    }
     compile_node(comp, pn_finally);
+    if (comp->scope_cur->emit_options <= MP_EMIT_OPT_BYTECODE) {
+        EMIT_ARG(adjust_stack_size, -1);
+    }
 
     compile_decrease_except_level(comp);
 }
diff --git a/tests/basics/try_finally_stack.py b/tests/basics/try_finally_stack.py
new file mode 100644
index 000000000..81054ae43
--- /dev/null
+++ b/tests/basics/try_finally_stack.py
@@ -0,0 +1,75 @@
+# Finally bodies need room for both their temporaries and the pending unwind state.
+
+
+class IDGenerator:
+    def __init__(self, max_id: int):
+        self._i = 0
+        self._mi = max_id
+
+    def get(self):
+        try:
+            return self._i
+        finally:
+            self._i += 1
+            if self._i > self._mi:
+                self._i = 0
+
+
+id_gen = IDGenerator(10)
+for _ in range(13):
+    print(id_gen.get())
+
+
+def return_with_stack(obj):
+    try:
+        return 42
+    finally:
+        obj._i = [1, 2, 3, 4, 5, 6, 7, 8]
+        print(obj._i)
+
+
+print(return_with_stack(id_gen))
+
+
+def return_from_except(obj):
+    try:
+        raise ValueError
+    except ValueError:
+        return 43
+    finally:
+        obj._i = [1, 2, 3, 4, 5, 6, 7, 8]
+        print(obj._i)
+
+
+print(return_from_except(id_gen))
+
+
+def jump_with_stack(obj, again):
+    while True:
+        try:
+            if again:
+                again = False
+                continue
+            break
+        finally:
+            obj._i = [1, 2, 3, 4, 5, 6, 7, 8]
+            print(obj._i)
+    print(obj._i)
+
+
+jump_with_stack(id_gen, True)
+
+
+def nested_finally(obj):
+    try:
+        return 44
+    finally:
+        try:
+            pass
+        finally:
+            obj._i = [1, 2, 3, 4, 5, 6, 7, 8]
+            print(obj._i)
+        print(obj._i)
+
+
+print(nested_finally(id_gen))
