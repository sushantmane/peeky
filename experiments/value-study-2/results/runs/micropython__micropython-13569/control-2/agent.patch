diff --git a/tests/basics/try_finally_stack.py b/tests/basics/try_finally_stack.py
new file mode 100644
index 000000000..b043bb6e1
--- /dev/null
+++ b/tests/basics/try_finally_stack.py
@@ -0,0 +1,90 @@
+# Finally blocks must have enough stack space while a return or jump is pending.
+
+
+class IDGenerator:
+    def __init__(self, max_id: int):
+        self._i = 0
+        self._mi = max_id
+
+    def get(self):
+        try:
+            return self._i
+        finally:
+            self._i += 1
+            if self._i > self._mi:
+                self._i = 0
+
+
+id_gen = IDGenerator(10)
+print([id_gen.get() for _ in range(24)])
+
+
+def consume(*args):
+    print(args)
+
+
+def return_value(value):
+    try:
+        return value
+    finally:
+        consume(1, 2, 3, 4, 5)
+        print(value)
+
+
+print(return_value(42))
+
+
+def except_return_value(value):
+    try:
+        return value
+    except ValueError:
+        return -1
+    finally:
+        consume(1, 2, 3, 4, 5)
+        print(value)
+
+
+print(except_return_value(43))
+
+
+def nested_finally(value):
+    try:
+        return value
+    finally:
+        try:
+            pass
+        finally:
+            consume(1, 2, 3, 4, 5)
+            print(value)
+        print(value)
+
+
+print(nested_finally(44))
+
+
+def break_loop(value):
+    while True:
+        try:
+            break
+        finally:
+            consume(1, 2, 3, 4, 5)
+            print(value)
+    print(value)
+
+
+break_loop(45)
+
+
+def continue_loop(value):
+    i = 0
+    while i < 2:
+        i += 1
+        try:
+            continue
+        finally:
+            consume(1, 2, 3, 4, 5)
+            print(value, i)
+    print(value, i)
+
+
+continue_loop(46)
