diff --git a/tests/basics/try_finally_stack.py b/tests/basics/try_finally_stack.py
new file mode 100644
index 000000000..6816cd9f2
--- /dev/null
+++ b/tests/basics/try_finally_stack.py
@@ -0,0 +1,69 @@
+# Finally temporaries must not overwrite locals while unwinding a return or jump.
+
+
+class IDGenerator:
+    def __init__(self, max_id: int):
+        self._i = 0
+        self._mi = max_id
+
+    def get(self):
+        try:
+            return self._i
+        finally:
+            self._i += 1
+            if self._i > self._mi:
+                self._i = 0
+
+
+id_gen = IDGenerator(2)
+for _ in range(5):
+    print(id_gen.get(), id_gen._i)
+
+
+def f(x):
+    try:
+        if x == 0:
+            return "try"
+        if x == 1:
+            raise ValueError
+    except ValueError:
+        return "except"
+    else:
+        return "else"
+    finally:
+        print("finally", x, x, x, x, x, x, x, x)
+        print("local", x)
+
+
+for x in range(3):
+    print(f(x))
+
+
+def nested(x):
+    try:
+        return x
+    finally:
+        try:
+            return x + 1
+        finally:
+            print("nested", x, x, x, x, x, x, x, x)
+            print("local", x)
+
+
+print(nested(10))
+
+
+def loop(x):
+    while x:
+        try:
+            if x == 1:
+                break
+            x -= 1
+            continue
+        finally:
+            print("loop", x, x, x, x, x, x, x, x)
+            print("local", x)
+    return x
+
+
+print(loop(3))
