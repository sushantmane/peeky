@@ -51,6 +51,8 @@
 	<@f.smallPrint>
 		<p>
 			Like other lombok handlers that touch fields, any field whose name starts with a dollar (<code>$</code>) symbol is skipped entirely. Such a field will not be modified at all.
+		</p><p>
+			The <code>lombok.fieldDefaults.defaultPrivate</code> and <code>lombok.fieldDefaults.defaultFinal</code> configuration keys do not apply to records. Explicit use of <code>@FieldDefaults</code> on a record is not supported.
 		</p>
 	</@f.smallPrint>
 </@f.scaffold>
