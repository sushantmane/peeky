+import lombok.Builder;
+import lombok.experimental.SuperBuilder;
+
+@SuperBuilder
+public class SuperBuilderDefaultsGenericsInference {
+	@Builder.Default
+	String foo = doSth(MyClass.myInt(), MyClass.myChar());
+
+	static class MyClass<T> {
+		final T value;
+
+		MyClass(T value) {
+			this.value = value;
+		}
+
+		static MyClass<Integer> myInt() {
+			return new MyClass<Integer>(42);
+		}
+
+		static MyClass<Character> myChar() {
+			return new MyClass<Character>('A');
+		}
+	}
+
+	static String doSth(MyClass<Integer> i, MyClass<Character> c) {
+		return i.value.toString() + c.value.toString();
+	}
+
+	@SuperBuilder
+	static class Child extends SuperBuilderDefaultsGenericsInference {
+	}
+
+	public static void main(String[] args) {
+		if (!"42A".equals(Child.builder().build().foo)) throw new AssertionError("Incorrect inherited default");
+		if (!"override".equals(Child.builder().foo("override").build().foo)) {
+			throw new AssertionError("Default must not override an explicit value");
+		}
+	}
+}
