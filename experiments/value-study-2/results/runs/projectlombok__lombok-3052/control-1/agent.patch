+// version 8:
+// platform javac
+import lombok.Builder;
+import lombok.Value;
+
+@Builder
+public class BuilderDefaultsGenericsInference {
+	@Builder.Default String foo = doSth(MyClass.myInt(), MyClass.myChar());
+
+	@Value
+	static class MyClass<T> {
+		T value;
+
+		static MyClass<Integer> myInt() {
+			return new MyClass<>(42);
+		}
+
+		static MyClass<Character> myChar() {
+			return new MyClass<>('A');
+		}
+	}
+
+	static String doSth(MyClass<Integer> i, MyClass<Character> c) {
+		return i.value.toString() + c.value.toString();
+	}
+
+	@lombok.experimental.SuperBuilder
+	static class SuperBuilderDefaults {
+		@Builder.Default String foo = doSth(MyClass.myInt(), MyClass.myChar());
+	}
+
+	public static void main(String[] args) {
+		if (!"42A".equals(builder().build().foo)) throw new AssertionError();
+		if (!"override".equals(builder().foo("override").build().foo)) throw new AssertionError();
+		if (builder().foo(null).build().foo != null) throw new AssertionError();
+		if (!"42A".equals(SuperBuilderDefaults.builder().build().foo)) throw new AssertionError();
+		if (!"override".equals(SuperBuilderDefaults.builder().foo("override").build().foo)) throw new AssertionError();
+		if (SuperBuilderDefaults.builder().foo(null).build().foo != null) throw new AssertionError();
+	}
+}
