@@ -0,0 +1,54 @@
+//platform javac
+import lombok.Builder;
+import lombok.experimental.SuperBuilder;
+
+@Builder
+public class BuilderDefaultsGenericsInference {
+	@Builder.Default String foo = doSth(MyClass.myInt(), MyClass.myChar());
+
+	static class MyClass<T> {
+		final T value;
+
+		MyClass(T value) {
+			this.value = value;
+		}
+
+		static MyClass<Integer> myInt() {
+			return new MyClass<Integer>(42);
+		}
+
+		static MyClass<Character> myChar() {
+			return new MyClass<Character>('A');
+		}
+	}
+
+	static String doSth(MyClass<Integer> i, MyClass<Character> c) {
+		return i.value.toString() + c.value.toString();
+	}
+
+	@SuperBuilder
+	static class Super {
+		@Builder.Default String foo = doSth(MyClass.myInt(), MyClass.myChar());
+	}
+
+	public static void main(String[] args) {
+		if (!"42A".equals(BuilderDefaultsGenericsInference.builder().build().foo)) {
+			throw new AssertionError("builder default");
+		}
+		if (!"override".equals(BuilderDefaultsGenericsInference.builder().foo("override").build().foo)) {
+			throw new AssertionError("builder override");
+		}
+		if (BuilderDefaultsGenericsInference.builder().foo(null).build().foo != null) {
+			throw new AssertionError("builder null override");
+		}
+		if (!"42A".equals(Super.builder().build().foo)) {
+			throw new AssertionError("super builder default");
+		}
+		if (!"override".equals(Super.builder().foo("override").build().foo)) {
+			throw new AssertionError("super builder override");
+		}
+		if (Super.builder().foo(null).build().foo != null) {
+			throw new AssertionError("super builder null override");
+		}
+	}
+}
