+++ b/test/transform/resource/after-delombok/BuilderDefaultsGenericsInference.java
@@ -0,0 +1,169 @@
+//platform javac
+public class BuilderDefaultsGenericsInference {
+	String foo;
+
+
+	static class MyClass<T> {
+		final T value;
+
+		MyClass(T value) {
+			this.value = value;
+		}
+
+		static MyClass<Integer> myInt() {
+			return new MyClass<Integer>(42);
+		}
+
+		static MyClass<Character> myChar() {
+			return new MyClass<Character>('A');
+		}
+	}
+
+	static String doSth(MyClass<Integer> i, MyClass<Character> c) {
+		return i.value.toString() + c.value.toString();
+	}
+
+
+	static class Super {
+		String foo;
+
+		@java.lang.SuppressWarnings("all")
+		private static String $default$foo() {
+			return doSth(MyClass.myInt(), MyClass.myChar());
+		}
+
+
+		@java.lang.SuppressWarnings("all")
+		public static abstract class SuperBuilder<C extends BuilderDefaultsGenericsInference.Super, B extends BuilderDefaultsGenericsInference.Super.SuperBuilder<C, B>> {
+			@java.lang.SuppressWarnings("all")
+			private boolean foo$set;
+			@java.lang.SuppressWarnings("all")
+			private String foo$value;
+
+			@java.lang.SuppressWarnings("all")
+			protected abstract B self();
+
+			@java.lang.SuppressWarnings("all")
+			public abstract C build();
+
+			/**
+			 * @return {@code this}.
+			 */
+			@java.lang.SuppressWarnings("all")
+			public B foo(final String foo) {
+				this.foo$value = foo;
+				foo$set = true;
+				return self();
+			}
+
+			@java.lang.Override
+			@java.lang.SuppressWarnings("all")
+			public java.lang.String toString() {
+				return "BuilderDefaultsGenericsInference.Super.SuperBuilder(foo$value=" + this.foo$value + ")";
+			}
+		}
+
+
+		@java.lang.SuppressWarnings("all")
+		private static final class SuperBuilderImpl extends BuilderDefaultsGenericsInference.Super.SuperBuilder<BuilderDefaultsGenericsInference.Super, BuilderDefaultsGenericsInference.Super.SuperBuilderImpl> {
+			@java.lang.SuppressWarnings("all")
+			private SuperBuilderImpl() {
+			}
+
+			@java.lang.Override
+			@java.lang.SuppressWarnings("all")
+			protected BuilderDefaultsGenericsInference.Super.SuperBuilderImpl self() {
+				return this;
+			}
+
+			@java.lang.Override
+			@java.lang.SuppressWarnings("all")
+			public BuilderDefaultsGenericsInference.Super build() {
+				return new BuilderDefaultsGenericsInference.Super(this);
+			}
+		}
+
+		@java.lang.SuppressWarnings("all")
+		protected Super(final BuilderDefaultsGenericsInference.Super.SuperBuilder<?, ?> b) {
+			if (b.foo$set) this.foo = b.foo$value;
+			 else this.foo = BuilderDefaultsGenericsInference.Super.$default$foo();
+		}
+
+		@java.lang.SuppressWarnings("all")
+		public static BuilderDefaultsGenericsInference.Super.SuperBuilder<?, ?> builder() {
+			return new BuilderDefaultsGenericsInference.Super.SuperBuilderImpl();
+		}
+	}
+
+	public static void main(String[] args) {
+		if (!"42A".equals(BuilderDefaultsGenericsInference.builder().build().foo)) {
+			throw new AssertionError("builder default");
+		}
+		if (!"override".equals(BuilderDefaultsGenericsInference.builder().foo("override").build().foo)) {
+			throw new AssertionError("builder override");
+		}
+		if (BuilderDefaultsGenericsInference.builder().foo(null).build().foo != null) {
+			throw new AssertionError("builder null override");
+		}
+		if (!"42A".equals(Super.builder().build().foo)) {
+			throw new AssertionError("super builder default");
+		}
+		if (!"override".equals(Super.builder().foo("override").build().foo)) {
+			throw new AssertionError("super builder override");
+		}
+		if (Super.builder().foo(null).build().foo != null) {
+			throw new AssertionError("super builder null override");
+		}
+	}
+
+	@java.lang.SuppressWarnings("all")
+	private static String $default$foo() {
+		return doSth(MyClass.myInt(), MyClass.myChar());
+	}
+
+	@java.lang.SuppressWarnings("all")
+	BuilderDefaultsGenericsInference(final String foo) {
+		this.foo = foo;
+	}
+
+
+	@java.lang.SuppressWarnings("all")
+	public static class BuilderDefaultsGenericsInferenceBuilder {
+		@java.lang.SuppressWarnings("all")
+		private boolean foo$set;
+		@java.lang.SuppressWarnings("all")
+		private String foo$value;
+
+		@java.lang.SuppressWarnings("all")
+		BuilderDefaultsGenericsInferenceBuilder() {
+		}
+
+		/**
+		 * @return {@code this}.
+		 */
+		@java.lang.SuppressWarnings("all")
+		public BuilderDefaultsGenericsInference.BuilderDefaultsGenericsInferenceBuilder foo(final String foo) {
+			this.foo$value = foo;
+			foo$set = true;
+			return this;
+		}
+
+		@java.lang.SuppressWarnings("all")
+		public BuilderDefaultsGenericsInference build() {
+			String foo$value = this.foo$value;
+			if (!this.foo$set) foo$value = BuilderDefaultsGenericsInference.$default$foo();
+			return new BuilderDefaultsGenericsInference(foo$value);
+		}
+
+		@java.lang.Override
+		@java.lang.SuppressWarnings("all")
+		public java.lang.String toString() {
+			return "BuilderDefaultsGenericsInference.BuilderDefaultsGenericsInferenceBuilder(foo$value=" + this.foo$value + ")";
+		}
+	}
+
+	@java.lang.SuppressWarnings("all")
+	public static BuilderDefaultsGenericsInference.BuilderDefaultsGenericsInferenceBuilder builder() {
+		return new BuilderDefaultsGenericsInference.BuilderDefaultsGenericsInferenceBuilder();
+	}
+}
