+    #[crate::test]
+    async fn extracting_on_nested_handler_after_matched_route() {
+        async fn handler(path: Option<MatchedPath>) -> &'static str {
+            assert!(path.is_none());
+            "nested"
+        }
+
+        let service = Router::new().nest_service("/", handler.into_service());
+        let apps = [
+            Router::new().fallback_service(service.clone()),
+            Router::new().route("/*path", crate::routing::get_service(service)),
+        ];
+
+        for app in apps {
+            let client = TestClient::new(app);
+
