+            assert!(req.extensions().get::<MatchedPath>().is_none());
+            req
+        }
+
+        let app = Router::new()
+            .nest("/nested", Router::new().fallback(handler))
+            .fallback(handler)
+            .layer(map_request(assert_no_matched_path));
+
+        let client = TestClient::new(app);
+
+        for path in ["/", "/missing", "/nested", "/nested/missing"] {
