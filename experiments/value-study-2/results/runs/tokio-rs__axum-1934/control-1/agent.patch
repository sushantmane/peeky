+    async fn cannot_extract_on_fallback() {
+        async fn fallback(path: Option<MatchedPath>) {
+            assert!(path.is_none());
+        }
+
+        for (app, paths) in [
+            (
+                Router::new().fallback(fallback),
+                ["/", "/missing", "/missing/deep"],
+            ),
+            (
+                Router::new().nest("/nested", Router::new().fallback(fallback)),
+                ["/nested", "/nested/missing", "/nested/missing/deep"],
+            ),
+        ] {
+            let client = TestClient::new(app);
+
+            for path in paths {
+                let res = client.get(path).send().await;
+                assert_eq!(res.status(), StatusCode::OK);
+            }
+        }
+    }
+
+    #[crate::test]
+    async fn extracting_on_handler_in_fallback_router() {
+        let fallback = Router::new().route(
+            "/users/:id",
+            get(|path: MatchedPath| async move { path.as_str().to_owned() }),
+        );
+
+        let app = Router::new().fallback_service(fallback);
+        let client = TestClient::new(app.clone());
+
+        let res = client.get("/users/123").send().await;
+        assert_eq!(res.status(), StatusCode::OK);
+        assert_eq!(res.text().await, "/users/:id");
+
+        let client = TestClient::new(Router::new().nest_service("/prefix", app));
+
+        let res = client.get("/prefix/users/123").send().await;
+        assert_eq!(res.status(), StatusCode::OK);
+        assert_eq!(res.text().await, "/prefix/users/:id");
+    }
