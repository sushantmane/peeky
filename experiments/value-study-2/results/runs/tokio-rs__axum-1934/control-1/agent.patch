+#[crate::test]
+async fn nest_static_file_server_as_fallback() {
+    let static_routes = Router::new().nest_service("/", get_service(ServeDir::new(".")));
+    let app = Router::new().fallback_service(static_routes);
+
+    let client = TestClient::new(app);
+
+    let res = client.get("/README.md").send().await;
+    assert_eq!(res.status(), StatusCode::OK);
+    assert_eq!(res.text().await, include_str!("../../../README.md"));
+
+    let res = client.get("/does-not-exist").send().await;
+    assert_eq!(res.status(), StatusCode::NOT_FOUND);
