+template <typename T, typename Char> class is_convertible_to_std_string_view {
+  using type = remove_cvref_t<T>;
+  using view = std_string_view<Char>;
+
+  template <typename V, typename U = type>
+  static auto check(int)
+      -> decltype(std::declval<const U&>().operator V(), std::true_type());
+  template <typename> static auto check(...) -> std::false_type;
+
+ public:
+  // A string_view range constructor doesn't make a range a string.
+  static constexpr const bool value =
+      std::is_convertible<const type&, view>::value &&
+      disjunction<decltype(check<view>(0)), decltype(check<view&>(0)),
+                  decltype(check<const view&>(0)), decltype(check<view&&>(0)),
+                  decltype(check<const view&&>(0))>::value;
+};
+
