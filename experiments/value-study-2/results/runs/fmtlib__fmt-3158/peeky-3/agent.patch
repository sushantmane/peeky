diff --git a/test/core-test.cc b/test/core-test.cc
index 6d1309fe..a1b43971 100644
--- a/test/core-test.cc
+++ b/test/core-test.cc
@@ -906,6 +906,39 @@ TEST(core_test, format_implicitly_convertible_to_string_view) {
   EXPECT_EQ("foo", fmt::format("{}", implicitly_convertible_to_string_view()));
 }
 
+template <typename StringView> struct mutable_string_view_conversion {
+  operator StringView() { return "foo"; }
+};
+
+TEST(core_test, string_view_conversion_requires_const) {
+  using mutable_fmt_view = mutable_string_view_conversion<fmt::string_view>;
+  EXPECT_FALSE(fmt::is_formattable<mutable_fmt_view>::value);
+#ifdef FMT_USE_STRING_VIEW
+  using mutable_std_view = mutable_string_view_conversion<std::string_view>;
+  EXPECT_FALSE(fmt::is_formattable<mutable_std_view>::value);
+#endif
+}
+
+#ifdef FMT_USE_STRING_VIEW
+template <typename View> struct const_string_view_conversion {
+  mutable std::string_view value = "foo";
+  operator View() const { return static_cast<View>(value); }
+};
+
+TEST(core_test, const_std_string_view_conversion) {
+  EXPECT_EQ("foo", fmt::format("{}", const_string_view_conversion<
+                                       std::string_view>()));
+  EXPECT_EQ("foo", fmt::format("{}", const_string_view_conversion<
+                                       std::string_view&>()));
+  EXPECT_EQ("foo", fmt::format("{}", const_string_view_conversion<
+                                       const std::string_view&>()));
+  EXPECT_EQ("foo", fmt::format("{}", const_string_view_conversion<
+                                       std::string_view&&>()));
+  EXPECT_EQ("foo", fmt::format("{}", const_string_view_conversion<
+                                       const std::string_view&&>()));
+}
+#endif
+
