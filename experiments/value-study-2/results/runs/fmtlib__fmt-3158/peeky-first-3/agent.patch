@@ -474,6 +474,7 @@ struct range_formatter<
     auto it = ctx.begin();
     auto end = ctx.end();
     if (it == end || *it == '}') {
+      it = underlying_.parse(ctx);
       maybe_set_debug_format();
       return it;
     }
@@ -483,7 +484,9 @@ struct range_formatter<
