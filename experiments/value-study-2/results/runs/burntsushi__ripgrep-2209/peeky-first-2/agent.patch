 use crate::hay::SHERLOCK;
 use crate::util::{Dir, TestCommand};
 
+rgtest!(replacement_named_capture, |dir: Dir, mut cmd: TestCommand| {
+    let input = format!(
+        "# first doc\n# second doc\npipc () {{  # usage\n{}",
+        "    function body\n".repeat(20),
+    );
+    dir.create("test", &input);
+    let pattern = concat!(
+        r"^(?P<predoc>\n?(# .*\n)*)",
+        r#"(alias (?P<aname>pipc)="[^"]+"|(?P<fname>pipc) \(\) \{)"#,
+        r"(  #(?P<usage> .+))?",
+    );
+    cmd.args(&["-NU", "-r", "$usage", pattern, "test"]);
+    eqnice!(" usage\n", cmd.stdout());
+});
+
+rgtest!(replacement_match_range, |dir: Dir, mut cmd: TestCommand| {
+    dir.create(
+        "test",
+        "before\nfoo\nbar tail\nbetween\nfoo\nbar tail\nafter\n",
+    );
+    cmd.args(&["-NU", "-r", "<$1>", r"(foo\nbar)", "test"]);
+    eqnice!("<foo\nbar> tail\n<foo\nbar> tail\n", cmd.stdout());
+
+    let mut cmd = dir.command();
+    cmd.args(&["-NUC1", "-r", "<$1>", r"(foo\nbar)", "test"]);
+    eqnice!(
+        "before\n<foo\nbar> tail\nbetween\n<foo\nbar> tail\nafter\n",
+        cmd.stdout()
+    );
+});
+
+rgtest!(replacement_look_ahead, |dir: Dir, mut cmd: TestCommand| {
+    if !dir.is_pcre2() {
+        return;
+    }
+    dir.create("test", "before\nfoo\nbar tail\nafter\n");
+    cmd.args(&[
+        "-NU",
+        "-r",
+        "<$1>",
+        r"(?<=before\n)(foo\nbar)(?= tail\nafter)",
+        "test",
+    ]);
+    eqnice!("<foo\nbar> tail\n", cmd.stdout());
+});
