--- a/tests/multiline.rs
+++ b/tests/multiline.rs
@@ -119,3 +119,36 @@ rgtest!(context, |dir: Dir, mut cmd: TestCommand| {
 ";
     eqnice!(expected, cmd.stdout());
 });
+
+rgtest!(replacement_capture, |dir: Dir, mut cmd: TestCommand| {
+    dir.create(
+        "test",
+        "before\n# first\npipc () {  # usage\nignored\n\
+         # second\npipc () {  # other\ntrailing\n",
+    );
+    let pattern = concat!(
+        r"^(?P<predoc>\n?(# .*\n)*)",
+        r"(?P<fname>pipc) \(\) \{(  #(?P<usage> .+))?",
+    );
+    cmd.args(&["-NU", "-r", "$usage", pattern, "test"]);
+    eqnice!(" usage\n other\n", cmd.stdout());
+
+    let mut cmd = dir.command();
+    cmd.args(&["-NUo", "-r", "$usage", pattern, "test"]);
+    eqnice!(" usage\n other\n", cmd.stdout());
+});
+
+rgtest!(replacement_lookaround, |dir: Dir, mut cmd: TestCommand| {
+    if !dir.is_pcre2() {
+        return;
+    }
+    dir.create("test", "foo\nbar\nfoo\nbaz\n");
+    cmd.args(&["-NU", "-r", "$1!", r"(?<=foo\n)(bar)(?=\nfoo)", "test"]);
+    eqnice!("bar!\n", cmd.stdout());
+});
+
+rgtest!(replacement_empty_boundary, |dir: Dir, mut cmd: TestCommand| {
+    dir.create("test", "foo\nbar\n");
+    cmd.args(&["-NU", "-r", "X", r"foo|$", "test"]);
+    eqnice!("X\nbarX\n", cmd.stdout());
+});
