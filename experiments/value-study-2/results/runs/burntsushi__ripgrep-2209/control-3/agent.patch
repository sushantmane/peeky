+    #[test]
+    fn replacement_multi_line_bounded() {
+        let matcher = RegexMatcher::new(r"foo\n(?P<last>bar)").unwrap();
+        let mut printer = StandardBuilder::new()
+            .replacement(Some(b"$last".to_vec()))
+            .build(NoColor::new(vec![]));
+        SearcherBuilder::new()
+            .line_number(true)
+            .multi_line(true)
+            .build()
+            .search_reader(
+                &matcher,
+                "before\nprefix foo\nbar suffix\nafter\n".as_bytes(),
+                printer.sink(&matcher),
+            )
+            .unwrap();
+
+        let got = printer_contents(&mut printer);
+        assert_eq_printed!("2:prefix bar suffix\n", got);
+    }
