+
+rgtest!(replacement_match_boundaries, |dir: Dir, mut cmd: TestCommand| {
+    dir.create(
+        "test",
+        "skip\nprefix a\nb a\nb suffix\ncontext\nprefix a\nb suffix\nend\n",
+    );
+    cmd.args(&["-N", "-U", "-r", "X", r"a\nb", "test"]);
+    eqnice!("prefix X X suffix\nprefix X suffix\n", cmd.stdout());
+    cmd.arg("-o");
+    eqnice!("X\nX\nX\n", cmd.stdout());
+});
+
+rgtest!(replacement_look_around, |dir: Dir, mut cmd: TestCommand| {
+    if !dir.is_pcre2() {
+        return;
+    }
+    dir.create("test", "before\na\nb\nc\nend\n");
+    cmd.args(&[
+        "-N",
+        "-U",
+        "-r",
+        "X",
+        r"(?<=before\n)a\nb(?=\nc)",
+        "test",
+    ]);
+    eqnice!("X\n", cmd.stdout());
+    cmd.arg("-C1");
+    eqnice!("before\nX\nc\n", cmd.stdout());
+});
+
+rgtest!(replacement_empty_at_end, |dir: Dir, mut cmd: TestCommand| {
