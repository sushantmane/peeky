diff --git a/tests/multiline.rs b/tests/multiline.rs
index d084c96..cb6a85f 100644
--- a/tests/multiline.rs
+++ b/tests/multiline.rs
@@ -119,3 +119,45 @@ rgtest!(context, |dir: Dir, mut cmd: TestCommand| {
 ";
     eqnice!(expected, cmd.stdout());
 });
+
+rgtest!(replacement_capture, |dir: Dir, mut cmd: TestCommand| {
+    let matched = "# documentation\npipc () {  # usage\n";
+    let pattern =
+        r"^(?P<predoc>\n?(# .*\n)*)(?P<fname>pipc) \(\) \{(  #(?P<usage> .+))?";
+    cmd.args(&["-NU", "-r", "$usage", pattern, "test"]);
+
+    // Exercise both sides of the printer's look-ahead buffer limit.
+    for len in &[0, 20, 127, 128, 129, 256] {
+        dir.create("test", &format!("{}{}", matched, "x".repeat(*len)));
+        eqnice!(" usage\n", cmd.stdout());
+    }
+});
+
+rgtest!(replacement_separate_matches, |dir: Dir, mut cmd: TestCommand| {
+    dir.create("test", "a\nb\nxxx\na\nb\n");
+    cmd.args(&["-NU", "-r", "X", "a\nb", "test"]);
+    eqnice!("X\nX\n", cmd.stdout());
+
+    cmd.arg("--only-matching");
+    eqnice!("X\nX\n", cmd.stdout());
+
+    let mut cmd = dir.command();
+    cmd.args(&["-NU", "-C1", "-r", "X", "a\nb", "test"]);
+    eqnice!("X\nxxx\nX\n", cmd.stdout());
+});
+
+rgtest!(replacement_look_around, |dir: Dir, mut cmd: TestCommand| {
+    if !dir.is_pcre2() {
+        return;
+    }
+
+    dir.create("test", "foo\nbar\nbaz\nend\nfoo\nbar\nbaz\n");
+    cmd.args(&[
+        "-NU",
+        "-r",
+        "<$word>",
+        r"(?<=foo\n)(?P<word>bar)(?=\nbaz)",
+        "test",
+    ]);
+    eqnice!("<bar>\n<bar>\n", cmd.stdout());
+});
