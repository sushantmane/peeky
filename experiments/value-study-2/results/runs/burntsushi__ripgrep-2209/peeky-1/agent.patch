+    fn replacement_multi_line_bounds() {
+        let matcher = RegexMatcher::new(r"foo\n(?P<word>bar)").unwrap();
+        for &len in &[0, 1, 127, 128, 129, 256] {
+            let haystack = format!(
+                "before\nprefix foo\nbar suffix\n{}", "x".repeat(len),
+            );
+            let mut printer = StandardBuilder::new()
+                .replacement(Some(b"$word".to_vec()))
+                .build(NoColor::new(vec![]));
+            SearcherBuilder::new()
+                .line_number(true)
+                .multi_line(true)
+                .build()
+                .search_reader(
+                    &matcher,
+                    haystack.as_bytes(),
+                    printer.sink(&matcher),
+                )
+                .unwrap();
+
+            let got = printer_contents(&mut printer);
+            assert_eq_printed!("2:prefix bar suffix\n", got);
+        }
+    }
