+    );
+    cmd.args(&[
+        "-NU",
+        "-r",
+        "$usage",
+        r"^(# .*\n)*(?P<fname>pipc) \(\) \{(  #(?P<usage> .+))?",
+        "test",
+    ]);
+    eqnice!(" usage\n", cmd.stdout());
+});
+
+rgtest!(replacement_match_range, |dir: Dir, mut cmd: TestCommand| {
+    dir.create("test", "before\nfoo\nbar after\nnot a match\nfoo\nbar\nlast\n");
+    cmd.args(&["-nU", "-r", "$name", r"foo\n(?P<name>bar)", "test"]);
+    eqnice!("2:bar after\n5:bar\n", cmd.stdout());
+
+    let mut cmd = dir.command();
+    cmd.args(&["-nUo", "-r", "$name", r"foo\n(?P<name>bar)", "test"]);
+    eqnice!("2:bar\n5:bar\n", cmd.stdout());
+});
+
+rgtest!(replacement_look_around, |dir: Dir, mut cmd: TestCommand| {
+    if !dir.is_pcre2() {
+        return;
+    }
+    dir.create("test", "before\nfoo\nbar after\nnot a match\nlast\n");
+    cmd.args(&[
+        "-nU",
+        "-r",
+        "$name",
+        r"(?<=before\n)foo\n(?P<name>bar)(?= after\nnot a match)",
+        "test",
+    ]);
+    eqnice!("2:bar after\n", cmd.stdout());
+});
+
+rgtest!(replacement_long_look_ahead, |dir: Dir, mut cmd: TestCommand| {
+    dir.create("test", &format!("foo\nbar\n{}\n", "x".repeat(256)));
+    cmd.args(&["-NU", "-r", "$name", r"foo\n(?P<name>bar)", "test"]);
+    eqnice!("bar\n", cmd.stdout());
+});
