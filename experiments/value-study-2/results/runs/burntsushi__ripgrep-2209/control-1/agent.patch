+rgtest!(replacement_named_groups, |dir: Dir, mut cmd: TestCommand| {
+    dir.create(
+        "patternfuncs.zsh",
+        "\
+# Compile requirements.txt files from all found or specified requirements.in files (compile).
+# Use -h to include hashes, -u dep1,dep2... to upgrade specific dependencies, and -U to upgrade all.
+pipc () {  # [-h] [-U|-u <pkgspec>[,<pkgspec>...]] [<reqs-in>...] [-- <pip-compile-arg>...]
+    emulate -L zsh
+    unset REPLY
+    if [[ $1 == --help ]] { zpy $0; return }
+    [[ $ZPY_PROCS ]] || return
+
+    local gen_hashes upgrade upgrade_csv
+    while [[ $1 == -[hUu] ]] {
+        if [[ $1 == -h ]] { gen_hashes=--generate-hashes; shift   }
+        if [[ $1 == -U ]] { upgrade=1;                    shift   }
+        if [[ $1 == -u ]] { upgrade=1; upgrade_csv=$2;    shift 2 }
+    }
+}
+",
+    );
+    cmd.args(&[
+        "-NU",
+        "--replace",
+        "$usage",
+        r#"^(?P<predoc>\n?(# .*\n)*)(alias (?P<aname>pipc)="[^"]+"|(?P<fname>pipc) \(\) \{)(  #(?P<usage> .+))?"#,
+        "patternfuncs.zsh",
+    ]);
+    eqnice!(
+        " [-h] [-U|-u <pkgspec>[,<pkgspec>...]] [<reqs-in>...] [-- <pip-compile-arg>...]\n",
+        cmd.stdout()
+    );
+});
+
+rgtest!(replacement_multiple_matches, |dir: Dir, mut cmd: TestCommand| {
+    dir.create(
+        "test",
+        "before\nprefix foo\nbar suffix\ncontext\nfoo\nbar\ntrailer\n",
+    );
+    cmd.args(&["-nU", "-r", "<$last>", r"foo\n(?P<last>bar)", "test"]);
+    eqnice!("2:prefix <bar> suffix\n5:<bar>\n", cmd.stdout());
+
+    cmd.arg("--only-matching");
+    eqnice!("2:<bar>\n5:<bar>\n", cmd.stdout());
+});
+
+rgtest!(replacement_empty_end, |dir: Dir, mut cmd: TestCommand| {
+    dir.create("test", "foo\nbar\n");
+    cmd.args(&["-NU", "-r", "X", r"foo\nbar|\z", "test"]);
+    eqnice!("X\n", cmd.stdout());
+
+    dir.create("single-line", "foo");
+    cmd = dir.command();
+    cmd.args(&["-N", "-r", "X", r"\z", "single-line"]);
+    eqnice!("fooX\n", cmd.stdout());
+});
+
+rgtest!(replacement_lookaround, |dir: Dir, mut cmd: TestCommand| {
+    if !dir.is_pcre2() {
+        return;
+    }
+    dir.create("test", "before\nfoo\nbar\ncontext\nfoo\nbar\ntail\n");
+    cmd.args(&[
+        "-nU",
+        "-r",
+        "$after",
+        r"(?<=\n)foo\nbar(?=\n(?P<after>context|tail))",
+        "test",
+    ]);
+    eqnice!("2:context\n5:tail\n", cmd.stdout());
+});
+
