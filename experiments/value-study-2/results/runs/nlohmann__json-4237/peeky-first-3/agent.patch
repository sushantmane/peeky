diff --git a/tests/src/unit-enum_serialization.cpp b/tests/src/unit-enum_serialization.cpp
new file mode 100644
index 00000000..360614a0
--- /dev/null
+++ b/tests/src/unit-enum_serialization.cpp
@@ -0,0 +1,83 @@
+//     __ _____ _____ _____
+//  __|  |   __|     |   | |  JSON for Modern C++ (supporting code)
+// |  |  |__   |  |  | | | |  version 3.11.3
+// |_____|_____|_____|_|___|  https://github.com/nlohmann/json
+//
+// SPDX-FileCopyrightText: 2013-2023 Niels Lohmann <https://nlohmann.me>
+// SPDX-License-Identifier: MIT
+
+#include "doctest_compatibility.h"
+
+#include <nlohmann/json.hpp>
+
+#include <array>
+#include <cstdint>
+#include <limits>
+#include <type_traits>
+
+namespace
+{
+template<typename BasicJsonType, typename EnumType>
+void check_enum_serialization()
+{
+    using underlying_type = typename std::underlying_type<EnumType>::type;
+    const std::array<underlying_type, 4> values = {{0, 1,
+        (std::numeric_limits<underlying_type>::min)(),
+        (std::numeric_limits<underlying_type>::max)()
+    }};
+
+    for (const auto value : values)
+    {
+        const auto e = static_cast<EnumType>(value);
+        const BasicJsonType expected(value);
+        const BasicJsonType j(e);
+
+        CHECK(j.type() == expected.type());
+        CHECK(j == expected);
+        CHECK(j.dump() == expected.dump());
+        CHECK(j.template get<EnumType>() == e);
+
+        BasicJsonType assigned = BasicJsonType::object();
+        assigned = e;
+        CHECK(assigned.type() == expected.type());
+        CHECK(assigned == expected);
+    }
+}
+} // namespace
+
+TEST_CASE_TEMPLATE("enum serialization preserves the underlying integer type", T,
+                   std::int8_t, std::uint8_t, std::int16_t, std::uint16_t,
+                   std::int32_t, std::uint32_t, std::int64_t, std::uint64_t)
+{
+    enum class scoped_enum : T {};
+    enum unscoped_enum : T {};
+
+    check_enum_serialization<nlohmann::json, scoped_enum>();
+    check_enum_serialization<nlohmann::json, unscoped_enum>();
+    check_enum_serialization<nlohmann::ordered_json, scoped_enum>();
+    check_enum_serialization<nlohmann::ordered_json, unscoped_enum>();
+}
+
+TEST_CASE("unsigned 64-bit enums serialize without a sign change")
+{
+    enum class book_id : std::uint64_t {};
+    const std::array<std::uint64_t, 3> values = {{
+        std::uint64_t(1) << 63,
+        (std::numeric_limits<std::uint64_t>::max)() - 1,
+        (std::numeric_limits<std::uint64_t>::max)()
+    }};
+    const std::array<const char*, 3> strings = {{
+        "9223372036854775808", "18446744073709551614", "18446744073709551615"
+    }};
+
+    for (std::size_t i = 0; i < values.size(); ++i)
+    {
+        const auto id = static_cast<book_id>(values[i]);
+        const nlohmann::json j(id);
+
+        CHECK(j > 0u);
+        CHECK(j.is_number_unsigned());
+        CHECK(to_string(j) == strings[i]);
+        CHECK(nlohmann::json::parse(strings[i]).get<book_id>() == id);
+    }
+}
