diff --git a/tests/src/unit-enum_serialization.cpp b/tests/src/unit-enum_serialization.cpp
new file mode 100644
index 00000000..bb177ba8
--- /dev/null
+++ b/tests/src/unit-enum_serialization.cpp
@@ -0,0 +1,65 @@
+//     __ _____ _____ _____
+//  __|  |   __|     |   | |  JSON for Modern C++ (supporting code)
+// |  |  |__   |  |  | | | |  version 3.11.3
+// |_____|_____|_____|_|___|  https://github.com/nlohmann/json
+//
+// SPDX-FileCopyrightText: 2013-2023 Niels Lohmann <https://nlohmann.me>
+// SPDX-License-Identifier: MIT
+
+#include "doctest_compatibility.h"
+
+#include <nlohmann/json.hpp>
+
+#include <cstdint>
+#include <limits>
+#include <string>
+#include <type_traits>
+
+using nlohmann::json;
+
+TEST_CASE_TEMPLATE("enum serialization preserves underlying signedness", IntegerType,
+                   std::int8_t, std::uint8_t, std::int16_t, std::uint16_t,
+                   std::int32_t, std::uint32_t, std::int64_t, std::uint64_t)
+{
+    enum class scoped_enum : IntegerType {};
+    enum unscoped_enum : IntegerType {};
+
+    const IntegerType values[] =
+    {
+        0,
+        1,
+        (std::numeric_limits<IntegerType>::min)(),
+        (std::numeric_limits<IntegerType>::max)(),
+        static_cast<IntegerType>((std::numeric_limits<IntegerType>::max)() / 2 + 1),
+        static_cast<IntegerType>((std::numeric_limits<IntegerType>::max)() - 1)
+    };
+
+    for (const auto value : values)
+    {
+        const auto scoped = static_cast<scoped_enum>(value);
+        const auto unscoped = static_cast<unscoped_enum>(value);
+
+        for (const json& j : {json(scoped), json(unscoped)})
+        {
+            CHECK(j.is_number_integer());
+            CHECK(j.is_number_unsigned() == std::is_unsigned<IntegerType>::value);
+            CHECK(j == json(value));
+            CHECK(to_string(j) == std::to_string(value));
+            CHECK(j.get<scoped_enum>() == scoped);
+            CHECK(j.get<unscoped_enum>() == unscoped);
+            CHECK(json::parse(j.dump()).get<scoped_enum>() == scoped);
+            if (value > 0)
+            {
+                CHECK(j > 0u);
+            }
+        }
+
+        json assigned = "previous value";
+        nlohmann::to_json(assigned, scoped);
+        CHECK(assigned == json(value));
+        CHECK(assigned.is_number_unsigned() == std::is_unsigned<IntegerType>::value);
+        assigned = unscoped;
+        CHECK(assigned == json(value));
+        CHECK(assigned.is_number_unsigned() == std::is_unsigned<IntegerType>::value);
+    }
+}
