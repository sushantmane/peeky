# peeky-study/r3-ponyc-llvm:15.0.7: the libraries ponyc's `make libs` builds (its vendored LLVM
# 15.0.7 with ponyc's patches, Google Test 1.12.1, Google Benchmark 1.7.1, blake2), installed in
# /opt/ponyc-libs, for ponylang__ponyc-4583 (base 115143f6), whose control image uses it as its
# build/libs. Only the install tree is kept: no ponyc source or history. As for LLVM 9.0.1
# (../ponylang__ponyc-3763/Dockerfile.llvm), built for the host's target alone (AArch64).
#   docker build -t peeky-study/r3-ponyc-llvm:15.0.7 -f Dockerfile.llvm <empty dir>
FROM peeky-study/base:1 AS build
ARG PONYC_COMMIT=115143f6bc5a90ff19c3af2bee68f3077fc5f1a3
# The base's compilers are newer than the ones ponyc's LLVM was written for: it may need
# <cstdint> and <limits> included, and no -Werror may fail on today's warnings. These wrappers
# are used for the libraries' build only (as for LLVM 9.0.1). A C++03 unit (Google Benchmark's
# cxx03_test) gets no includes: <cstdint> needs C++11.
RUN mkdir -p /opt/ponyc-cc && \
    printf '#!/bin/sh\nexec clang-18 "$@" -Wno-error\n' > /opt/ponyc-cc/clang && \
    printf '#!/bin/sh\ncase " $* " in *" -std=c++98 "*|*" -std=c++03 "*|*" -std=gnu++98 "*|*" -std=gnu++03 "*) exec clang++-18 "$@" -Wno-error ;; *" -c "*) exec clang++-18 -include cstdint -include limits "$@" -Wno-error -Wno-enum-constexpr-conversion ;; esac\nexec clang++-18 "$@"\n' > /opt/ponyc-cc/clang++ && \
    chmod +x /opt/ponyc-cc/clang /opt/ponyc-cc/clang++
RUN git clone -q https://github.com/ponylang/ponyc.git /testbed && cd /testbed && \
    git checkout -q $PONYC_COMMIT && git submodule update --init --depth 1 lib/llvm/src
WORKDIR /testbed
# ponyc's own recipe (`make libs`), for the host's target (llvm_archs defaults to five targets).
RUN make libs CC=/opt/ponyc-cc/clang CXX=/opt/ponyc-cc/clang++ llvm_archs=AArch64 build_flags=-j4 \
      > /root/libs.log 2>&1; status=$?; tail -40 /root/libs.log; \
    grep -E "error:|Error [0-9]" /root/libs.log | head -40; exit $status
RUN ls build/libs build/libs/lib | head -80 && test -f build/libs/lib/cmake/llvm/LLVMConfig.cmake && \
    build/libs/bin/llvm-config --version

FROM peeky-study/base:1
COPY --from=build /testbed/build/libs /opt/ponyc-libs
