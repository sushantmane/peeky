     use http::{Request, StatusCode};
 
+    #[crate::test]
+    async fn cannot_extract_in_fallback() {
+        async fn fallback(path: Option<MatchedPath>) {
+            assert!(path.is_none());
+        }
+
+        let app = Router::new()
+            .nest("/nested", Router::new().fallback(fallback))
+            .fallback(fallback);
+
+        let client = TestClient::new(app);
+
+        for uri in ["/", "/not-found", "/nested/not-found"] {
+            let res = client.get(uri).send().await;
+            assert_eq!(res.status(), StatusCode::OK);
+        }
+    }
+
+    #[crate::test]
+    async fn extracting_on_handler_in_fallback_router() {
+        async fn handler(path: MatchedPath) -> String {
+            path.as_str().to_owned()
+        }
+
+        let fallback = Router::new()
+            .route("/direct/:a", get(handler))
+            .nest_service("/nested/:a", Router::new().route("/:b", get(handler)));
+        let app = Router::new().fallback_service(fallback);
+
+        let client = TestClient::new(app);
+
+        for (uri, expected) in [
+            ("/direct/foo", "/direct/:a"),
+            ("/nested/foo/bar", "/nested/:a/:b"),
+        ] {
+            let res = client.get(uri).send().await;
+            assert_eq!(res.status(), StatusCode::OK);
+            assert_eq!(res.text().await, expected);
+        }
+    }
+
