+    #[crate::test]
+    async fn fallback_does_not_set_matched_path() {
+        async fn fallback(path: Option<MatchedPath>) {
+            assert!(path.is_none());
+        }
+
+        let app = Router::new()
+            .nest("/nested", Router::new().fallback(fallback))
+            .fallback(fallback);
+        let client = TestClient::new(app);
+
+        for path in ["/", "/missing", "/nested/missing"] {
+            let res = client.get(path).send().await;
+            assert_eq!(res.status(), StatusCode::OK);
+        }
+    }
+
+    #[crate::test]
+    async fn fallback_service_preserves_matched_path() {
+        let app = Router::new().fallback_service(Router::new().route(
+            "/:id",
+            get(|path: MatchedPath| async move { path.as_str().to_owned() }),
+        ));
+        let client = TestClient::new(app);
+
+        let res = client.get("/foo").send().await;
+        assert_eq!(res.status(), StatusCode::OK);
+        assert_eq!(res.text().await, "/:id");
+    }
+
+    #[crate::test]
+    async fn fallback_service_preserves_nested_matched_path() {
+        let app = Router::new().nest_service(
+            "/:outer",
+            Router::new().fallback_service(Router::new().nest_service(
+                "/:middle",
+                Router::new().route(
+                    "/:inner",
+                    get(|path: MatchedPath| async move { path.as_str().to_owned() }),
+                ),
+            )),
+        );
+        let client = TestClient::new(app);
+
+        let res = client.get("/foo/bar/baz").send().await;
+        assert_eq!(res.status(), StatusCode::OK);
+        assert_eq!(res.text().await, "/:outer/:middle/:inner");
+    }
