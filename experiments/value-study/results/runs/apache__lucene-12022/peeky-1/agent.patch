+  public void testCollapsedTriangleEdgeFlags() {
+    byte[] bytes = new byte[7 * ShapeField.BYTES];
+    ShapeField.DecodedTriangle decoded = new ShapeField.DecodedTriangle();
+    for (int collapsedEdge = 0; collapsedEdge < 3; collapsedEdge++) {
+      int ax = encodeX(0);
+      int ay = encodeY(0);
+      int bx = encodeX(collapsedEdge == 0 ? 0 : 2);
+      int by = encodeY(collapsedEdge == 0 ? 0 : 2);
+      int cx = encodeX(collapsedEdge == 2 ? 0 : 2);
+      int cy = encodeY(collapsedEdge == 2 ? 0 : 2);
+      for (boolean fromShape : new boolean[] {false, true}) {
+        ShapeField.encodeTriangle(
+            bytes,
+            ay,
+            ax,
+            collapsedEdge == 0 ? !fromShape : fromShape,
+            by,
+            bx,
+            collapsedEdge == 1 ? !fromShape : fromShape,
+            cy,
+            cx,
+            collapsedEdge == 2 ? !fromShape : fromShape);
+        ShapeField.decodeTriangle(bytes, decoded);
+        assertEquals(ShapeField.DecodedTriangle.TYPE.LINE, decoded.type);
+        assertEquals(encodeX(0), decoded.aX);
+        assertEquals(encodeY(0), decoded.aY);
+        assertEquals(encodeX(2), decoded.bX);
+        assertEquals(encodeY(2), decoded.bY);
+        assertEquals(decoded.aX, decoded.cX);
+        assertEquals(decoded.aY, decoded.cY);
+        assertEquals(fromShape, decoded.ab);
+      }
+    }
+  }
