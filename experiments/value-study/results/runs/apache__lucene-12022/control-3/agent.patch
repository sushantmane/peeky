+package org.apache.lucene.document;
+
+import org.apache.lucene.document.ShapeField.QueryRelation;
+import org.apache.lucene.geo.Polygon;
+import org.apache.lucene.index.IndexReader;
+import org.apache.lucene.search.IndexSearcher;
+import org.apache.lucene.store.Directory;
+import org.apache.lucene.tests.index.RandomIndexWriter;
+import org.apache.lucene.tests.util.LuceneTestCase;
+
+public class TestShapeField extends LuceneTestCase {
+
+  public void testCollapsedTriangleEdgeFlags() {
+    byte[] bytes = new byte[7 * ShapeField.BYTES];
+    ShapeField.DecodedTriangle triangle = new ShapeField.DecodedTriangle();
+    for (int repeatedPoint = 0; repeatedPoint < 2; repeatedPoint++) {
+      for (int distinctVertex = 0; distinctVertex < 3; distinctVertex++) {
+        int[] coordinates = {repeatedPoint, repeatedPoint, repeatedPoint};
+        coordinates[distinctVertex] = 1 - repeatedPoint;
+        for (int flags = 0; flags < 8; flags++) {
+          boolean[] edges = {(flags & 1) != 0, (flags & 2) != 0, (flags & 4) != 0};
+          ShapeField.encodeTriangle(
+              bytes,
+              coordinates[0],
+              coordinates[0],
+              edges[0],
+              coordinates[1],
+              coordinates[1],
+              edges[1],
+              coordinates[2],
+              coordinates[2],
+              edges[2]);
+          ShapeField.decodeTriangle(bytes, triangle);
+          boolean expectedBoundary = false;
+          for (int edge = 0; edge < 3; edge++) {
+            expectedBoundary |= edges[edge] && coordinates[edge] != coordinates[(edge + 1) % 3];
+          }
+          assertEquals(ShapeField.DecodedTriangle.TYPE.LINE, triangle.type);
+          assertEquals(expectedBoundary, triangle.ab);
+          assertEquals(0, triangle.aX);
+          assertEquals(0, triangle.aY);
+          assertEquals(1, triangle.bX);
+          assertEquals(1, triangle.bY);
+          assertEquals(triangle.aX, triangle.cX);
+          assertEquals(triangle.aY, triangle.cY);
+        }
+      }
+    }
+  }
+
+  public void testContainsFlatPolygon() throws Exception {
+    // Two distinct vertices quantize to the same point, collapsing an internal diagonal.
+    Polygon polygon =
+        new Polygon(
+            new double[] {10, 10, 1, -10, 1 - 2e-10, 1, 10},
+            new double[] {10, 1, 1, -10, 1 + 1e-10, 10, 10});
+    Polygon crossing = new Polygon(new double[] {4, 4, 6, 6, 4}, new double[] {0, 2, 2, 0, 0});
+    Polygon inside = new Polygon(new double[] {4, 4, 6, 6, 4}, new double[] {2, 3, 3, 2, 2});
+    try (Directory dir = newDirectory();
+        RandomIndexWriter writer = new RandomIndexWriter(random(), dir)) {
+      Document doc = new Document();
+      for (Field field : LatLonShape.createIndexableFields("shape", polygon, true)) {
+        doc.add(field);
+      }
+      writer.addDocument(doc);
+      try (IndexReader reader = writer.getReader()) {
+        IndexSearcher searcher = newSearcher(reader);
+        for (QueryRelation relation : QueryRelation.values()) {
+          int expected = relation == QueryRelation.INTERSECTS ? 1 : 0;
+          assertEquals(
+              expected, searcher.count(LatLonShape.newPolygonQuery("shape", relation, crossing)));
+          assertEquals(
+              expected, searcher.count(LatLonShape.newBoxQuery("shape", relation, 4, 6, 0, 2)));
+        }
+        assertEquals(
+            1,
+            searcher.count(LatLonShape.newPolygonQuery("shape", QueryRelation.CONTAINS, inside)));
+        assertEquals(
+            1, searcher.count(LatLonShape.newBoxQuery("shape", QueryRelation.CONTAINS, 4, 6, 2, 3)));
+      }
+    }
+  }
+}
