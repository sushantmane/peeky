+  public void testCollapsedTriangleEdgeFlags() {
+    int[] x = {encodeX(0), encodeX(2)};
+    int[] y = {encodeY(0), encodeY(2)};
+    byte[] bytes = new byte[7 * ShapeField.BYTES];
+    ShapeField.DecodedTriangle decoded = new ShapeField.DecodedTriangle();
+    for (int vertices = 1; vertices < 7; vertices++) {
+      int a = vertices & 1;
+      int b = (vertices >> 1) & 1;
+      int c = (vertices >> 2) & 1;
+      for (int edges = 0; edges < 8; edges++) {
+        boolean ab = (edges & 1) != 0;
+        boolean bc = (edges & 2) != 0;
+        boolean ca = (edges & 4) != 0;
+        ShapeField.encodeTriangle(bytes, y[a], x[a], ab, y[b], x[b], bc, y[c], x[c], ca);
+        ShapeField.decodeTriangle(bytes, decoded);
+        assertEquals(ShapeField.DecodedTriangle.TYPE.LINE, decoded.type);
+        assertEquals(x[0], decoded.aX);
+        assertEquals(y[0], decoded.aY);
+        assertEquals(x[1], decoded.bX);
+        assertEquals(y[1], decoded.bY);
+        assertEquals(decoded.aX, decoded.cX);
+        assertEquals(decoded.aY, decoded.cY);
+        assertEquals((a != b && ab) || (b != c && bc) || (c != a && ca), decoded.ab);
+      }
+    }
+  }
