diff --git a/tests/basics/try_finally_return6.py b/tests/basics/try_finally_return6.py
new file mode 100644
index 000000000..b920b5473
--- /dev/null
+++ b/tests/basics/try_finally_return6.py
@@ -0,0 +1,81 @@
+# A pending return needs an extra stack slot while executing finally.
+
+
+class IDGenerator:
+    def __init__(self, max_id):
+        self._i = 0
+        self._mi = max_id
+
+    def get(self):
+        try:
+            return self._i
+        finally:
+            self._i += 1
+            if self._i > self._mi:
+                self._i = 0
+
+    def get_except(self, mode):
+        try:
+            if mode:
+                raise ValueError
+        except ValueError:
+            return self._i
+        else:
+            return self._i
+        finally:
+            self._i += 1
+            if self._i > self._mi:
+                self._i = 0
+
+
+id_gen = IDGenerator(2)
+for _ in range(5):
+    print(id_gen.get(), id_gen._i)
+for mode in (False, True):
+    for _ in range(5):
+        print(id_gen.get_except(mode), id_gen._i)
+
+
+# Each active finally must account for its own pending return state.
+def nested(x):
+    try:
+        return x
+    finally:
+        try:
+            return x + 1
+        finally:
+            print(x, x + 1, x + 2, x + 3, x + 4)
+
+
+print(nested(10))
+
+
+# Unwinding break and continue also leaves extra state on the stack.
+def loop(x):
+    while x:
+        try:
+            if x == 1:
+                break
+            x -= 1
+            continue
+        finally:
+            print(x, x + 1, x + 2, x + 3, x + 4)
+    return x
+
+
+print(loop(3))
+
+
+def fallthrough(x):
+    try:
+        if x:
+            raise ValueError
+    finally:
+        print(x, x + 1, x + 2, x + 3, x + 4)
+
+
+fallthrough(0)
+try:
+    fallthrough(1)
+except ValueError:
+    print("ValueError")
