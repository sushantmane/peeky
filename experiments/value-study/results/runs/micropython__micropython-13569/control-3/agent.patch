diff --git a/tests/basics/try_finally_stack.py b/tests/basics/try_finally_stack.py
new file mode 100644
index 000000000..0e14ebd31
--- /dev/null
+++ b/tests/basics/try_finally_stack.py
@@ -0,0 +1,86 @@
+# Finally blocks need stack space for a pending return or unwind jump as well
+# as their own expressions, even when the try body needs very little stack.
+
+
+class IDGenerator:
+    def __init__(self, max_id):
+        self._i = 0
+        self._mi = max_id
+
+    def get(self):
+        try:
+            return self._i
+        finally:
+            self._i += 1
+            if self._i > self._mi:
+                self._i = 0
+
+    def get_with_except(self):
+        try:
+            return self._i
+        except ValueError:
+            return -1
+        finally:
+            self._i = (0, 1, 2, 3, 4, self._i + 1)[-1]
+            if self._i > self._mi:
+                self._i = 0
+
+
+ids = IDGenerator(10)
+for _ in range(13):
+    print(ids.get())
+for _ in range(13):
+    print(ids.get_with_except())
+
+
+def nested(value):
+    try:
+        return value
+    finally:
+        try:
+            return value
+        finally:
+            print(0, 1, 2, 3, 4, 5, value)
+
+
+print(nested("return"))
+
+
+def loop(value):
+    for i in range(3):
+        try:
+            if i == 0:
+                continue
+            break
+        finally:
+            print(0, 1, 2, 3, 4, 5, value)
+
+
+loop("jump")
+
+
+def with_except(value, mode):
+    try:
+        if mode == "exception":
+            raise ValueError
+    except ValueError:
+        return value
+    else:
+        if mode == "return":
+            return value
+    finally:
+        print(0, 1, 2, 3, 4, 5, value, mode)
+
+
+for mode in ("exception", "return", "fallthrough"):
+    print(with_except("except", mode))
+
+
+def generator(value):
+    try:
+        return
+    finally:
+        yield (0, 1, 2, 3, 4, 5, value)
+
+
+print(list(generator("yield")))
