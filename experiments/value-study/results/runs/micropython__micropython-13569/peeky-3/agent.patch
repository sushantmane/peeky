diff --git a/tests/basics/try_finally_return6.py b/tests/basics/try_finally_return6.py
new file mode 100644
index 000000000..3fc114d23
--- /dev/null
+++ b/tests/basics/try_finally_return6.py
@@ -0,0 +1,87 @@
+# A finally block needs space for both the pending return value and its sentinel.
+class IDGenerator:
+    def __init__(self, max_id):
+        self._i = 0
+        self._mi = max_id
+
+    def get(self):
+        try:
+            return self._i
+        finally:
+            self._i += 1
+            if self._i > self._mi:
+                self._i = 0
+
+
+id_gen = IDGenerator(2)
+for _ in range(7):
+    print(id_gen.get())
+
+
+def f(value):
+    try:
+        return value
+    finally:
+        print(value, 1, 2, 3, 4, 5, 6, 7)
+
+
+print(f("return"))
+
+
+def f(value):
+    try:
+        try:
+            return value
+        finally:
+            try:
+                return value
+            finally:
+                print(value, 1, 2, 3, 4, 5, 6, 7)
+    finally:
+        print(value, 8, 9, 10, 11, 12, 13, 14)
+
+
+print(f("nested"))
+
+
+def f(value):
+    try:
+        return value
+    except ValueError:
+        pass
+    finally:
+        print(value, 1, 2, 3, 4, 5, 6, 7)
+
+
+print(f("except"))
+
+
+def f(value):
+    for i in range(2):
+        try:
+            if i:
+                break
+            continue
+        finally:
+            print(value, i, 1, 2, 3, 4, 5, 6, 7)
+    return value
+
+
+print(f("jump"))
+
+
+def f(value):
+    try:
+        pass
+    finally:
+        print(value, 1, 2, 3, 4, 5, 6, 7)
+    try:
+        raise ValueError
+    finally:
+        print(value, 8, 9, 10, 11, 12, 13, 14)
+
+
+try:
+    f("exception")
+except ValueError:
+    print("caught")
