diff --git a/tests/basics/try_finally_stack.py b/tests/basics/try_finally_stack.py
new file mode 100644
index 000000000..8536dd271
--- /dev/null
+++ b/tests/basics/try_finally_stack.py
@@ -0,0 +1,56 @@
+# Check stack space for finally blocks entered with a pending return or jump.
+
+
+class IDGenerator:
+    def __init__(self, max_id: int):
+        self._i = 0
+        self._mi = max_id
+
+    def get(self):
+        try:
+            return self._i
+        finally:
+            self._i += 1
+            if self._i > self._mi:
+                self._i = 0
+
+
+id_gen = IDGenerator(10)
+print([id_gen.get() for _ in range(24)])
+
+
+def f(mode):
+    for i in range(2):
+        try:
+            if mode == "return":
+                return i
+            if mode == "break":
+                break
+            if mode == "continue":
+                continue
+            if mode == "raise":
+                raise ValueError
+        except ValueError:
+            return i + 10
+        else:
+            print("else", i)
+        finally:
+            print("finally", mode, i, 1, 2, 3)
+    return "done"
+
+
+for mode in ("return", "break", "continue", "raise", "normal"):
+    print(mode, f(mode))
+
+
+def nested():
+    try:
+        return 42
+    finally:
+        try:
+            return 43
+        finally:
+            print("nested", 1, 2, 3, 4, 5)
+
+
+print(nested())
