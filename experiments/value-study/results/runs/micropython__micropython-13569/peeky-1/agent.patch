index 000000000..64cc04a64
--- /dev/null
+++ b/tests/basics/try_finally_stack.py
@@ -0,0 +1,47 @@
+# Unwinding a return needs an extra stack slot throughout the finally block.
+class IDGenerator:
+    def __init__(self, max_id: int):
+        self._i = 0
+        self._mi = max_id
+
+    def get(self):
+        try:
+            return self._i
+        finally:
+            self._i += 1
+            if self._i > self._mi:
+                self._i = 0
+
+    def get_with_except(self):
+        try:
+            return self._i
+        except ValueError:
+            return -1
+        finally:
+            self._i += 1
+            if self._i > self._mi:
+                self._i = 0
+
+
+id_gen = IDGenerator(10)
+for _ in range(13):
+    print(id_gen.get(), id_gen._i)
+for _ in range(13):
+    print(id_gen.get_with_except(), id_gen._i)
+
+
+# The extra stack entry is also needed when unwinding break and continue.
+def loop_jump(obj, do_break):
+    while obj._i < obj._mi:
+        try:
+            if do_break:
+                break
+            continue
+        finally:
+            obj._i += 1
+            obj._i = min(obj._i, obj._mi)
+    print(obj._i, do_break)
+
+
+loop_jump(IDGenerator(3), False)
+loop_jump(IDGenerator(3), True)
