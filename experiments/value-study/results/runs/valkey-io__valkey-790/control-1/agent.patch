diff --git a/tests/unit/cluster/failover.tcl b/tests/unit/cluster/failover.tcl
index f36fd47fe..e9d2f4f6c 100644
--- a/tests/unit/cluster/failover.tcl
+++ b/tests/unit/cluster/failover.tcl
@@ -56,6 +56,31 @@ test "Instance #5 is now a master" {
     assert {[s -5 role] eq {master}}
 }
 
+test "CLUSTER SHARDS reports slot ranges after failover" {
+    set primary_id [R 5 cluster myid]
+    set expected_slots {}
+    foreach slot_range [R 5 cluster slots] {
+        if {[lindex $slot_range 2 2] eq $primary_id} {
+            lappend expected_slots {*}[lrange $slot_range 0 1]
+        }
+    }
+    assert {[llength $expected_slots] > 0}
+
+    for {set j 1} {$j < [llength $::servers]} {incr j} {
+        set found 0
+        foreach shard [R $j cluster shards] {
+            foreach node [dict get $shard nodes] {
+                if {[dict get $node id] eq $primary_id} {
+                    assert_equal $expected_slots [dict get $shard slots]
+                    set found 1
+                    break
+                }
+            }
+        }
+        assert {$found}
+    }
+}
+
 test "Restarting the previously killed master node" {
     resume_process $paused_pid
 }
