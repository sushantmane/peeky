diff --git a/tests/unit/cluster/failover.tcl b/tests/unit/cluster/failover.tcl
index f36fd47fe..43725c5c9 100644
--- a/tests/unit/cluster/failover.tcl
+++ b/tests/unit/cluster/failover.tcl
@@ -56,6 +56,30 @@ test "Instance #5 is now a master" {
     assert {[s -5 role] eq {master}}
 }
 
+test "CLUSTER SHARDS reports slots after failover while the old master is down" {
+    for {set j 1} {$j < [llength $::servers]} {incr j} {
+        set slots_by_node {}
+        foreach slot_range [R $j cluster slots] {
+            set node_id [lindex $slot_range 2 2]
+            dict lappend slots_by_node $node_id [lindex $slot_range 0]
+            dict lappend slots_by_node $node_id [lindex $slot_range 1]
+        }
+
+        set shards [R $j cluster shards]
+        assert_equal 5 [llength $shards]
+        foreach shard $shards {
+            set expected_slots {}
+            foreach node [dict get $shard nodes] {
+                set node_id [dict get $node id]
+                if {[dict exists $slots_by_node $node_id]} {
+                    lappend expected_slots {*}[dict get $slots_by_node $node_id]
+                }
+            }
+            assert_equal $expected_slots [dict get $shard slots]
+        }
+    }
+}
+
 test "Restarting the previously killed master node" {
