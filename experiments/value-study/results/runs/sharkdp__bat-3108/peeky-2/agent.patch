+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn plain_and_paging_precedence() {
+        for interactive_output in [false, true] {
+            let automatic = if interactive_output {
+                PagingMode::QuitIfOneScreen
+            } else {
+                PagingMode::Never
+            };
+            let cases: &[(&[&str], PagingMode)] = &[
+                (&["--plain"], automatic),
+                (&["-pp"], PagingMode::Never),
+                (&["-p", "-p"], PagingMode::Never),
+                (&["--paging=never", "--plain"], PagingMode::Never),
+                (&["--plain", "--paging=never"], PagingMode::Never),
+                (&["--paging=always", "--plain"], PagingMode::Always),
+                (&["--plain", "--paging=always"], PagingMode::Always),
+                (&["--paging=auto", "--plain"], automatic),
+                (&["--plain", "--paging=auto"], automatic),
+                (&["--paging=always", "-pp"], PagingMode::Never),
+                (&["-pp", "--paging=always"], PagingMode::Always),
+                (&["--paging=auto", "-pp"], PagingMode::Never),
+                (&["-pp", "--paging=auto"], automatic),
+                (&["--paging=never", "-pp"], PagingMode::Never),
+                (&["-pp", "--paging=never"], PagingMode::Never),
+            ];
+
+            for &(args, expected) in cases {
+                let app = App {
+                    matches: clap_app::build_app(interactive_output)
+                        .get_matches_from(["bat"].into_iter().chain(args.iter().copied())),
+                    interactive_output,
+                };
+                let config = app.config(&[]).unwrap();
+                assert_eq!(config.paging_mode, expected, "args: {args:?}");
+                assert!(config.style_components.plain(), "args: {args:?}");
+            }
+        }
+    }
+}
