+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn paging_with_plain() {
+        use PagingMode::{Always, Never, QuitIfOneScreen};
+
+        let cases: &[(&[&str], PagingMode)] = &[
+            (&["--plain"], QuitIfOneScreen),
+            (&["--paging=never", "--plain"], Never),
+            (&["--plain", "--paging=never"], Never),
+            (&["--paging=never", "-p"], Never),
+            (&["-p", "--paging=never"], Never),
+            (&["--paging=always", "--plain"], Always),
+            (&["--plain", "--paging=always"], Always),
+            (&["--paging=auto", "--plain"], QuitIfOneScreen),
+            (&["--plain", "--paging=auto"], QuitIfOneScreen),
+            (&["-pp"], Never),
+            (&["--plain", "--plain"], Never),
+            (&["--paging=always", "-pp"], Never),
+            (&["-pp", "--paging=always"], Always),
+            (&["--paging=auto", "-pp"], Never),
+            (&["-pp", "--paging=auto"], QuitIfOneScreen),
+            (&["--paging=never", "-pp"], Never),
+            (&["-pp", "--paging=never"], Never),
+        ];
+
+        for &(args, expected) in cases {
+            for interactive_output in [false, true] {
+                let app = App {
+                    matches: clap_app::build_app(interactive_output)
+                        .get_matches_from(std::iter::once("bat").chain(args.iter().copied())),
+                    interactive_output,
+                };
+                let config = app.config(&[Input::ordinary_file("test.txt")]).unwrap();
+                let expected = if !interactive_output && expected == QuitIfOneScreen {
+                    Never
+                } else {
+                    expected
+                };
+                assert_eq!(config.paging_mode, expected, "{args:?}");
+                assert!(config.style_components.plain(), "{args:?}");
+            }
+        }
+    }
+}
