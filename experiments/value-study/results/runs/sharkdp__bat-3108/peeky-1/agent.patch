+
+#[test]
+fn paging_with_plain() {
+    use PagingMode::{Always, Never, QuitIfOneScreen};
+
+    let cases: &[(&[&str], PagingMode)] = &[
+        (&["--paging=never", "--plain"], Never),
+        (&["--paging=never", "-p"], Never),
+        (&["--plain", "--paging=never"], Never),
+        (&["-p", "--paging=never"], Never),
+        (&["--paging=always", "--plain"], Always),
+        (&["--paging=always", "-p"], Always),
+        (&["--plain", "--paging=always"], Always),
+        (&["-p", "--paging=always"], Always),
+        (&["--plain"], QuitIfOneScreen),
+        (&["-pp"], Never),
+        (&["--plain", "--plain"], Never),
+        (&["--paging=always", "-pp"], Never),
+        (&["-pp", "--paging=always"], Always),
+        (&["--paging=auto", "-pp"], Never),
+        (&["-pp", "--paging=auto"], QuitIfOneScreen),
+        (&["-p", "--paging=always", "-p"], Never),
+    ];
+
+    for &(args, expected) in cases {
+        let app = App {
+            matches: clap_app::build_app(true)
+                .get_matches_from(std::iter::once("bat").chain(args.iter().copied())),
+            interactive_output: true,
+        };
+        let config = app.config(&[]).unwrap();
+
+        assert_eq!(config.paging_mode, expected, "args: {args:?}");
+        assert!(config.style_components.plain(), "args: {args:?}");
+    }
+}
