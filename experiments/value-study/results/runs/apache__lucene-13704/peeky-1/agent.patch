+  public void testComponentPredicateAtNorthPole() {
+    double minLat = decodeLatitude(Integer.MAX_VALUE - 3);
+    double maxLat = decodeLatitude(Integer.MAX_VALUE);
+    double minLon = decodeLongitude(Integer.MAX_VALUE - 3);
+    double maxLon = decodeLongitude(Integer.MAX_VALUE);
+    Component2D component =
+        LatLonGeometry.create(
+            new Polygon(
+                new double[] {minLat, minLat, maxLat, maxLat, minLat},
+                new double[] {minLon, maxLon, maxLon, minLon, minLon}));
+    GeoEncodingUtils.Component2DPredicate predicate =
+        GeoEncodingUtils.createComponentPredicate(component);
+    for (int latOffset = 0; latOffset <= 4; latOffset++) {
+      for (int lonOffset = 0; lonOffset <= 4; lonOffset++) {
+        int lat = Integer.MAX_VALUE - latOffset;
+        int lon = Integer.MAX_VALUE - lonOffset;
+        assertEquals(latOffset <= 3 && lonOffset <= 3, predicate.test(lat, lon));
+      }
+    }
+    assertFalse(predicate.test(Integer.MIN_VALUE, Integer.MAX_VALUE));
+    assertFalse(predicate.test(0, Integer.MAX_VALUE));
+  }
+
+  public void testDistancePredicateAtNorthPole() {
+    int lat = Integer.MAX_VALUE - 2;
+    int lon = Integer.MAX_VALUE - 2;
+    GeoEncodingUtils.DistancePredicate predicate =
+        GeoEncodingUtils.createDistancePredicate(decodeLatitude(lat), decodeLongitude(lon), 0.01);
+    assertTrue(predicate.test(lat, lon));
+    assertTrue(predicate.test(Integer.MAX_VALUE, lon));
+    assertFalse(predicate.test(Integer.MIN_VALUE, lon));
+    assertFalse(predicate.test(0, lon));
+  }
