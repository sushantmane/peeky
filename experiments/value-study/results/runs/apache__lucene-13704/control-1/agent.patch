+  public void testComponentPredicateCloseToNorthPole() {
+    double minLat = decodeLatitude(Integer.MAX_VALUE - 3);
+    double maxLat = decodeLatitude(Integer.MAX_VALUE);
+    double minLon = decodeLongitude(Integer.MAX_VALUE - 3);
+    double maxLon = decodeLongitude(Integer.MAX_VALUE);
+    Polygon polygon =
+        new Polygon(
+            new double[] {minLat, minLat, maxLat, maxLat, minLat},
+            new double[] {minLon, maxLon, maxLon, minLon, minLon});
+    GeoEncodingUtils.Component2DPredicate predicate =
+        GeoEncodingUtils.createComponentPredicate(LatLonGeometry.create(polygon));
+
+    assertTrue(predicate.test(Integer.MAX_VALUE - 2, Integer.MAX_VALUE - 2));
+    assertTrue(predicate.test(Integer.MAX_VALUE, Integer.MAX_VALUE));
+    assertFalse(predicate.test(Integer.MAX_VALUE - 4, Integer.MAX_VALUE - 2));
+    assertFalse(predicate.test(Integer.MAX_VALUE - 2, Integer.MAX_VALUE - 4));
+    assertFalse(predicate.test(Integer.MIN_VALUE, Integer.MAX_VALUE - 2));
+  }
+
+  public void testDistancePredicateCloseToNorthPole() {
+    double lat = decodeLatitude(Integer.MAX_VALUE - 2);
+    double lon = decodeLongitude(Integer.MAX_VALUE - 2);
+    GeoEncodingUtils.DistancePredicate predicate =
+        GeoEncodingUtils.createDistancePredicate(lat, lon, 0.01);
+
+    assertTrue(predicate.test(Integer.MAX_VALUE - 2, Integer.MAX_VALUE - 2));
+    assertFalse(predicate.test(Integer.MAX_VALUE - 64, Integer.MAX_VALUE - 2));
+    assertFalse(predicate.test(Integer.MIN_VALUE, Integer.MAX_VALUE - 2));
+  }
