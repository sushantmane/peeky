+  public void testComponentPredicateAtPoles() {
+    for (int minLat : new int[] {Integer.MIN_VALUE, Integer.MAX_VALUE - 3}) {
+      for (int minLon : new int[] {Integer.MIN_VALUE, Integer.MAX_VALUE - 3}) {
+        double minY = decodeLatitude(minLat);
+        double maxY = decodeLatitude(minLat + 3);
+        double minX = decodeLongitude(minLon);
+        double maxX = decodeLongitude(minLon + 3);
+        Polygon polygon =
+            new Polygon(
+                new double[] {minY, minY, maxY, maxY, minY},
+                new double[] {minX, maxX, maxX, minX, minX});
+        GeoEncodingUtils.Component2DPredicate predicate =
+            GeoEncodingUtils.createComponentPredicate(LatLonGeometry.create(polygon));
+        for (int latOffset = 0; latOffset < 8; latOffset++) {
+          int lat =
+              minLat == Integer.MIN_VALUE
+                  ? Integer.MIN_VALUE + latOffset
+                  : Integer.MAX_VALUE - latOffset;
+          for (int lonOffset = 0; lonOffset < 8; lonOffset++) {
+            int lon =
+                minLon == Integer.MIN_VALUE
+                    ? Integer.MIN_VALUE + lonOffset
+                    : Integer.MAX_VALUE - lonOffset;
+            assertEquals(latOffset <= 3 && lonOffset <= 3, predicate.test(lat, lon));
+          }
+        }
+      }
+    }
+  }
+
+  public void testDistancePredicateAtPoles() {
+    for (int lat : new int[] {Integer.MIN_VALUE + 2, Integer.MAX_VALUE - 2}) {
+      GeoEncodingUtils.DistancePredicate predicate =
+          GeoEncodingUtils.createDistancePredicate(decodeLatitude(lat), 0, 0.01);
+      assertTrue(predicate.test(lat, 0));
+      assertFalse(predicate.test(0, 0));
+    }
+  }
