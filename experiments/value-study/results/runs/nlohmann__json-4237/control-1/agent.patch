+TEST_CASE_TEMPLATE("enum integer serialization", T,
+                   std::int8_t, std::uint8_t, std::int16_t, std::uint16_t,
+                   std::int32_t, std::uint32_t, std::int64_t, std::uint64_t)
+{
+    enum class scoped_enum : T {};
+    enum unscoped_enum : T {};
+
+    for (const T value : {(std::numeric_limits<T>::min)(), T(0), (std::numeric_limits<T>::max)()})
+    {
+        const json expected = value;
+        const auto scoped = static_cast<scoped_enum>(value);
+        const auto unscoped = static_cast<unscoped_enum>(value);
+
+        const json scoped_json = scoped;
+        CHECK(scoped_json.type() == expected.type());
+        CHECK(scoped_json == expected);
+        CHECK(scoped_json.dump() == expected.dump());
+        CHECK(scoped_json.get<scoped_enum>() == scoped);
+
+        const json unscoped_json = unscoped;
+        CHECK(unscoped_json.type() == expected.type());
+        CHECK(unscoped_json == expected);
+        CHECK(unscoped_json.dump() == expected.dump());
+        CHECK(unscoped_json.get<unscoped_enum>() == unscoped);
+
+        json assigned = "replace this string";
+        assigned = scoped;
+        CHECK(assigned.type() == expected.type());
+        CHECK(assigned == expected);
+    }
+}
+
+TEST_CASE("unsigned 64-bit enum serialization")
+{
+    enum class book_id : std::uint64_t {};
+    const auto large_id = static_cast<book_id>(std::uint64_t(1) << 63);
+    const json large_json = large_id;
+
+    CHECK(large_json > 0u);
+    CHECK(to_string(large_json) == "9223372036854775808");
+    CHECK(large_json.is_number_unsigned());
+    CHECK(json::parse(to_string(large_json)).get<book_id>() == large_id);
+
+    const auto special_id = static_cast<book_id>((std::numeric_limits<std::uint64_t>::max)() - 1);
+    const json special_json = special_id;
+
+    CHECK(to_string(special_json) == "18446744073709551614");
+    CHECK(special_json.is_number_unsigned());
+    CHECK(json::parse(to_string(special_json)).get<book_id>() == special_id);
+}
