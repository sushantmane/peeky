+TEST_CASE("enum serialization preserves underlying signedness")
+{
+    SECTION("unsigned 64-bit enum")
+    {
+        enum class unsigned_enum : std::uint64_t {};
+        for (const auto value : {std::uint64_t(0), std::uint64_t(1),
+                                 (std::uint64_t(1) << 63) - 1,
+                                 std::uint64_t(1) << 63,
+                                 (std::numeric_limits<std::uint64_t>::max)() - 1,
+                                 (std::numeric_limits<std::uint64_t>::max)()})
+        {
+            CAPTURE(value);
+            const auto e = static_cast<unsigned_enum>(value);
+            json j(e);
+            CHECK(j.is_number_unsigned());
+            CHECK(j.get<std::uint64_t>() == value);
+            CHECK(j.dump() == std::to_string(value));
+            CHECK(j.get<unsigned_enum>() == e);
+            if (value != 0)
+            {
+                CHECK(j > 0u);
+            }
+
+            j = "replace an allocated value";
+            nlohmann::to_json(j, e);
+            CHECK(j.is_number_unsigned());
+            CHECK(j.get<std::uint64_t>() == value);
+        }
+    }
+
+    SECTION("signed 64-bit enum")
+    {
+        enum class signed_enum : std::int64_t {};
+        for (const auto value : {(std::numeric_limits<std::int64_t>::min)(),
+                                 std::int64_t(-1), std::int64_t(0), std::int64_t(1),
+                                 (std::numeric_limits<std::int64_t>::max)()})
+        {
+            CAPTURE(value);
+            const auto e = static_cast<signed_enum>(value);
+            const json j(e);
+            CHECK(j.type() == json::value_t::number_integer);
+            CHECK(j.get<std::int64_t>() == value);
+            CHECK(j.dump() == std::to_string(value));
+            CHECK(j.get<signed_enum>() == e);
+        }
+    }
+
+    SECTION("unscoped unsigned enum")
+    {
+        enum unsigned_enum : std::uint32_t
+        {
+            max_value = (std::numeric_limits<std::uint32_t>::max)()
+        };
+        const json j(max_value);
+        CHECK(j.is_number_unsigned());
+        CHECK(j.dump() == "4294967295");
+        CHECK(j.get<unsigned_enum>() == max_value);
+    }
+}
+
 enum class cards {kreuz, pik, herz, karo};
 
