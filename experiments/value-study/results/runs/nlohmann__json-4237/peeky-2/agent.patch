+TEST_CASE_TEMPLATE("enum serialization preserves the underlying integer type", T,
+                   std::int8_t, std::uint8_t, std::int16_t, std::uint16_t,
+                   std::int32_t, std::uint32_t, std::int64_t, std::uint64_t)
+{
+    enum class scoped_enum : T {};
+    enum unscoped_enum : T {};
+
+    for (const auto value : {T(0), T(1), (std::numeric_limits<T>::min)(), (std::numeric_limits<T>::max)()})
+    {
+        const json expected = value;
+        for (const auto& actual : {json(static_cast<scoped_enum>(value)), json(static_cast<unscoped_enum>(value))})
+        {
+            CHECK(actual.type() == expected.type());
+            CHECK(actual == expected);
+            CHECK(actual.dump() == expected.dump());
+            CHECK(actual.template get<scoped_enum>() == static_cast<scoped_enum>(value));
+            CHECK(actual.template get<unscoped_enum>() == static_cast<unscoped_enum>(value));
+        }
+    }
+}
+
+TEST_CASE("large unsigned enums serialize as positive numbers")
+{
+    enum class book_id : std::uint64_t {};
+    const auto large_id = static_cast<book_id>(std::uint64_t(1) << 63);
+    const json j = large_id;
+
+    CHECK(j > 0u);
+    CHECK(to_string(j) == "9223372036854775808");
+    CHECK(j.is_number_unsigned());
+    CHECK(j.get<book_id>() == large_id);
+
+    const auto special_id = static_cast<book_id>((std::numeric_limits<std::uint64_t>::max)() - 1);
+    CHECK(to_string(json(special_id)) == "18446744073709551614");
+}
