+TEST_CASE_TEMPLATE("enum serialization preserves underlying integer type", IntegerType,
+                   std::int8_t, std::uint8_t, std::int16_t, std::uint16_t,
+                   std::int32_t, std::uint32_t, std::int64_t, std::uint64_t)
+{
+    enum class scoped_enum : IntegerType {};
+    enum unscoped_enum : IntegerType {};
+
+    for (const auto value : {(std::numeric_limits<IntegerType>::min)(), IntegerType(0),
+                             IntegerType(1), (std::numeric_limits<IntegerType>::max)()})
+    {
+        const json expected = value;
+        for (const auto& j : {json(static_cast<scoped_enum>(value)),
+                             json(static_cast<unscoped_enum>(value))})
+        {
+            CHECK(j.type() == expected.type());
+            CHECK(j == expected);
+            CHECK(j.dump() == expected.dump());
+            CHECK(j.template get<scoped_enum>() == static_cast<scoped_enum>(value));
+            CHECK(j.template get<unscoped_enum>() == static_cast<unscoped_enum>(value));
+        }
+    }
+}
+
+TEST_CASE("unsigned enum serialization above the signed integer range")
+{
+    enum class book_id : std::uint64_t {};
+
+    for (const auto& entry :
+            {
+                std::make_pair(std::uint64_t(1) << 63, "9223372036854775808"),
+                std::make_pair((std::numeric_limits<std::uint64_t>::max)() - 1, "18446744073709551614"),
+                std::make_pair((std::numeric_limits<std::uint64_t>::max)(), "18446744073709551615")
+            })
+    {
+        const auto id = static_cast<book_id>(entry.first);
+        const json j = id;
+
+        CHECK(j > 0u);
+        CHECK(j.is_number_unsigned());
+        CHECK(to_string(j) == entry.second);
+        CHECK(json::parse(j.dump()).get<book_id>() == id);
+    }
+}
+
