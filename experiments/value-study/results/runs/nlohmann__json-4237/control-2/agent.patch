diff --git a/tests/src/unit-enum_serialization.cpp b/tests/src/unit-enum_serialization.cpp
new file mode 100644
index 00000000..0dd98238
--- /dev/null
+++ b/tests/src/unit-enum_serialization.cpp
@@ -0,0 +1,75 @@
+//     __ _____ _____ _____
+//  __|  |   __|     |   | |  JSON for Modern C++ (supporting code)
+// |  |  |__   |  |  | | | |  version 3.11.3
+// |_____|_____|_____|_|___|  https://github.com/nlohmann/json
+//
+// SPDX-FileCopyrightText: 2013-2023 Niels Lohmann <https://nlohmann.me>
+// SPDX-License-Identifier: MIT
+
+#include "doctest_compatibility.h"
+
+#include <nlohmann/json.hpp>
+using nlohmann::json;
+
+#include <cstdint>
+#include <limits>
+
+TEST_CASE_TEMPLATE("enum serialization preserves the underlying integer type", T,
+                   std::int8_t, std::uint8_t, std::int16_t, std::uint16_t,
+                   std::int32_t, std::uint32_t, std::int64_t, std::uint64_t)
+{
+    enum class scoped_enum : T {};
+    enum unscoped_enum : T {};
+
+    for (const T value : {(std::numeric_limits<T>::min)(), T(0), T(1), (std::numeric_limits<T>::max)()})
+    {
+        CAPTURE(value);
+        const json expected = value;
+
+        for (const auto& j : {json(static_cast<scoped_enum>(value)), json(static_cast<unscoped_enum>(value))})
+        {
+            CHECK(j.type() == expected.type());
+            CHECK(j.template get<T>() == value);
+            CHECK(j.dump() == expected.dump());
+            CHECK(j.template get<scoped_enum>() == static_cast<scoped_enum>(value));
+            CHECK(j.template get<unscoped_enum>() == static_cast<unscoped_enum>(value));
+        }
+
+        json assigned = "replace this string";
+        nlohmann::to_json(assigned, static_cast<scoped_enum>(value));
+        CHECK(assigned.type() == expected.type());
+        CHECK(assigned == expected);
+
+        assigned = "replace this string";
+        assigned = static_cast<unscoped_enum>(value);
+        CHECK(assigned.type() == expected.type());
+        CHECK(assigned == expected);
+    }
+}
+
+TEST_CASE("unsigned 64-bit enums serialize without becoming negative")
+{
+    enum class book_id : std::uint64_t
+    {
+        high_bit = std::uint64_t(1) << 63,
+        almost_max = (std::numeric_limits<std::uint64_t>::max)() - 1,
+        max = (std::numeric_limits<std::uint64_t>::max)()
+    };
+
+    const json large_id = book_id::high_bit;
+    CHECK(large_id > 0u);
+    CHECK(to_string(large_id) == "9223372036854775808");
+    CHECK(large_id.is_number_unsigned());
+    CHECK(json::parse(large_id.dump()).get<book_id>() == book_id::high_bit);
+
+    const json almost_max = book_id::almost_max;
+    CHECK(almost_max > 0u);
+    CHECK(almost_max.dump() == "18446744073709551614");
+    CHECK(almost_max.is_number_unsigned());
+    CHECK(json::parse(almost_max.dump()).get<book_id>() == book_id::almost_max);
+
+    const json max = book_id::max;
+    CHECK(max.dump() == "18446744073709551615");
+    CHECK(max.is_number_unsigned());
+    CHECK(json::parse(max.dump()).get<book_id>() == book_id::max);
+}
