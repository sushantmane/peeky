+template <typename T, typename Char> class is_std_string_view_like {
+  template <typename U>
+  static auto check(int)
+      -> decltype(std::declval<const U&>().operator std_string_view<Char>(),
+                  std::true_type());
+  template <typename> static auto check(...) -> std::false_type;
+
+ public:
+  static constexpr const bool value =
+      std::is_convertible<const T&, std_string_view<Char>>::value &&
+      (is_string<T>::value || decltype(check<T>(0))::value);
+};
