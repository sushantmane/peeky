+rgtest!(replace_named_capture, |dir: Dir, _: TestCommand| {
+    for suffix in &["    body\n}\n".to_string(), "x".repeat(256)] {
+        dir.create("test", &format!("# doc\nfunc () {{  # usage\n{}", suffix));
+        let output = dir
+            .command()
+            .args(&[
+                "-NU",
+                "-r",
+                "$usage",
+                r"(?P<doc># .*\n)func \(\) \{  #(?P<usage> .+)",
+                "test",
+            ])
+            .stdout();
+        eqnice!(" usage\n", output);
+    }
+});
+
+rgtest!(replace_multiple, |dir: Dir, _: TestCommand| {
+    dir.create(
+        "test",
+        "before\nfoo\nbar tail\nunmatched\nfoo\nbar tail\nlast\n",
+    );
+    for flag in &["--no-heading", "--only-matching", "--vimgrep"] {
+        let output = dir
+            .command()
+            .args(&["-U", "-rquux", flag, r"foo\nbar", "test"])
+            .stdout();
+        let expected = match *flag {
+            "--only-matching" => "quux\nquux\n",
+            "--vimgrep" => "test:2:1:quux tail\ntest:5:1:quux tail\n",
+            _ => "quux tail\nquux tail\n",
+        };
+        eqnice!(expected, output);
+    }
+});
+
+rgtest!(replace_empty_at_eof, |dir: Dir, _: TestCommand| {
+    dir.create("test", "abc");
+    for flag in &["-N", "-NU"] {
+        let output = dir.command().args(&[flag, "-rX", "$", "test"]).stdout();
+        eqnice!("abcX\n", output);
+    }
+});
+
+rgtest!(replace_look_ahead, |dir: Dir, mut cmd: TestCommand| {
+    if !dir.is_pcre2() {
+        return;
+    }
+    dir.create("test", "before\nfoo\nbar\nafter\nfoo\nbar\nafter\n");
+    cmd.args(&[
+        "-NU",
+        "-r${word}",
+        r"foo\n(?P<word>bar)(?=\nafter)",
+        "test",
+    ]);
+    eqnice!("bar\nbar\n", cmd.stdout());
+});
