+rgtest!(replacement, |dir: Dir, mut cmd: TestCommand| {
+    dir.create("test", "foo\nbar\nuntouched\n");
+    cmd.args(&["-NU", "-r", "$value", r"foo\n(?P<value>bar)", "test"]);
+    eqnice!("bar\n", cmd.stdout());
+});
+
+rgtest!(replacement_multiple_matches, |dir: Dir, mut cmd: TestCommand| {
+    dir.create(
+        "test",
+        "before\nprefix foo\nbar suffix\nuntouched\nprefix foo\nbar suffix\nlast\n",
+    );
+    cmd.args(&["-NU", "-r", "$value", r"foo\n(?P<value>bar)", "test"]);
+    eqnice!("prefix bar suffix\nprefix bar suffix\n", cmd.stdout());
+    eqnice!("bar\nbar\n", cmd.arg("-o").stdout());
+});
+
+rgtest!(replacement_empty_at_eof, |dir: Dir, mut cmd: TestCommand| {
+    dir.create("test", "foo");
+    cmd.args(&["-NU", "-r", "X", r"$|\n", "test"]);
+    eqnice!("fooX\n", cmd.stdout());
+});
+
+rgtest!(replacement_lookaround, |dir: Dir, mut cmd: TestCommand| {
+    // Only PCRE2 supports look-around.
+    if !dir.is_pcre2() {
+        return;
+    }
+    dir.create("test", "before\nfoo\nbar\nbaz\nafter\nfoo\nbar\nbaz\nlast\n");
+    cmd.args(&[
+        "-NU",
+        "-r",
+        "$value",
+        r"(?<=before\n)foo\n(?P<value>bar)(?=\nbaz)",
+        "test",
+    ]);
+    eqnice!("bar\n", cmd.stdout());
+});
