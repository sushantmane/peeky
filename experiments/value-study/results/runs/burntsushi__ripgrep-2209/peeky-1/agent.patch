diff --git a/tests/multiline.rs b/tests/multiline.rs
index d084c96..a6ff41d 100644
--- a/tests/multiline.rs
+++ b/tests/multiline.rs
@@ -119,3 +119,56 @@ rgtest!(context, |dir: Dir, mut cmd: TestCommand| {
 ";
     eqnice!(expected, cmd.stdout());
 });
+
+rgtest!(replacement, |dir: Dir, mut cmd: TestCommand| {
+    dir.create("test", "# doc\nfunc () {  # usage\n    body\n}\n");
+    cmd.args(&[
+        "-NU",
+        "-r",
+        "$usage",
+        r"^(# .*\n)*(?P<name>func) \(\) \{  #(?P<usage> .+)",
+        "test",
+    ]);
+    eqnice!(" usage\n", cmd.stdout());
+});
+
+rgtest!(replacement_match_boundaries, |dir: Dir, mut cmd: TestCommand| {
+    dir.create(
+        "test",
+        "before\nabc\ndef tail\nnot matched\nabc\ndef tail\nafter\n",
+    );
+    cmd.args(&["-NU", "-r", "X", r"abc\ndef", "test"]);
+    eqnice!("X tail\nX tail\n", cmd.stdout());
+
+    cmd.arg("-o");
+    eqnice!("X\nX\n", cmd.stdout());
+});
+
+rgtest!(replacement_lookaround, |dir: Dir, mut cmd: TestCommand| {
+    if !dir.is_pcre2() {
+        return;
+    }
+    dir.create(
+        "test",
+        "\
+before
+abc
+def tail
+lookahead
+not matched
+before
+abc
+def tail
+lookahead
+after
+",
+    );
+    cmd.args(&[
+        "-NU",
+        "-r",
+        "X",
+        r"(?<=before\n)abc\ndef(?= tail\nlookahead)",
+        "test",
+    ]);
+    eqnice!("X tail\nX tail\n", cmd.stdout());
+});
