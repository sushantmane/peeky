+rgtest!(replace, |dir: Dir, mut cmd: TestCommand| {
+    let haystack = format!(
+        "before\nfoo\nbar\nafter\nfoo\nbaz\n{}",
+        "trailing context\n".repeat(20),
+    );
+    dir.create("test", &haystack);
+    cmd.args(&["-U", "-r", "$value", r"foo\n(?P<value>.+)", "test"]);
+    eqnice!("bar\nbaz\n", cmd.stdout());
+});
+
+rgtest!(replace_only_matching, |dir: Dir, mut cmd: TestCommand| {
+    dir.create("test", "before\nfoo\nbar\nafter\nfoo\nbaz\ntail\n");
+    cmd.args(&["-U", "-o", "-r", "$value", r"foo\n(?P<value>.+)", "test"]);
+    eqnice!("bar\nbaz\n", cmd.stdout());
+});
+
+rgtest!(replace_lookaround, |dir: Dir, mut cmd: TestCommand| {
+    if !dir.is_pcre2() {
+        return;
+    }
+    dir.create("test", "before\nfoo\nbar\nafter\n");
+    cmd.args(&[
+        "-U",
+        "-r",
+        "$value",
+        r"(?<=before\n)foo\n(?P<value>bar)(?=\nafter)",
+        "test",
+    ]);
+    eqnice!("bar\n", cmd.stdout());
