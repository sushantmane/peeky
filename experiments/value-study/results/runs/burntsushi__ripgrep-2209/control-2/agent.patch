+rgtest!(replacement_named_capture, |dir: Dir, mut cmd: TestCommand| {
+    dir.create("test", "# doc\nfunc () {  # usage\n    body\n}\n");
+    cmd.args(&[
+        "-NU",
+        "-r",
+        "$usage",
+        r"^(# .*\n)*func \(\) \{(  #(?P<usage> .+))?",
+        "test",
+    ]);
+    eqnice!(" usage\n", cmd.stdout());
+});
+
+rgtest!(replacement_multiple_matches, |dir: Dir, mut cmd: TestCommand| {
+    dir.create("test", "prefix\nfoo\nbar baz\nafter\nfoo\nbar quux\nlast\n");
+    cmd.args(&["-NU", "-r", "$name:$1", r"(foo)\n(?P<name>bar)", "test"]);
+    eqnice!("bar:foo baz\nbar:foo quux\n", cmd.stdout());
+
+    let mut cmd = dir.command();
+    cmd.args(&["-NUo", "-r", "$name:$1", r"(foo)\n(?P<name>bar)", "test"]);
+    eqnice!("bar:foo\nbar:foo\n", cmd.stdout());
+});
+
+rgtest!(replacement_look_around, |dir: Dir, mut cmd: TestCommand| {
+    if !dir.is_pcre2() {
+        return;
+    }
+    dir.create("test", "before\nfoo\nbar\nbefore\nfoo\nbar\n");
+    cmd.args(&[
+        "-NU",
+        "-r",
+        "$1!",
+        r"(?<=before\n)(foo)(?=\nbar)",
+        "test",
+    ]);
+    eqnice!("foo!\nfoo!\n", cmd.stdout());
+});
