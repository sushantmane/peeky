@@ -0,0 +1,166 @@
+//platform javac
+public class BuilderDefaultsGenericsInference {
+
+	public static class BuilderWithDefault {
+		String foo;
+
+		@java.lang.SuppressWarnings("all")
+		private static String $default$foo() {
+			return doSth(MyClass.myInt(), MyClass.myChar());
+		}
+
+		@java.lang.SuppressWarnings("all")
+		BuilderWithDefault(final String foo) {
+			this.foo = foo;
+		}
+
+
+		@java.lang.SuppressWarnings("all")
+		public static class BuilderWithDefaultBuilder {
+			@java.lang.SuppressWarnings("all")
+			private boolean foo$set;
+			@java.lang.SuppressWarnings("all")
+			private String foo$value;
+
+			@java.lang.SuppressWarnings("all")
+			BuilderWithDefaultBuilder() {
+			}
+
+			/**
+			 * @return {@code this}.
+			 */
+			@java.lang.SuppressWarnings("all")
+			public BuilderDefaultsGenericsInference.BuilderWithDefault.BuilderWithDefaultBuilder foo(final String foo) {
+				this.foo$value = foo;
+				foo$set = true;
+				return this;
+			}
+
+			@java.lang.SuppressWarnings("all")
+			public BuilderDefaultsGenericsInference.BuilderWithDefault build() {
+				String foo$value = this.foo$value;
+				if (!this.foo$set) foo$value = BuilderWithDefault.$default$foo();
+				return new BuilderDefaultsGenericsInference.BuilderWithDefault(foo$value);
+			}
+
+			@java.lang.Override
+			@java.lang.SuppressWarnings("all")
+			public java.lang.String toString() {
+				return "BuilderDefaultsGenericsInference.BuilderWithDefault.BuilderWithDefaultBuilder(foo$value=" + this.foo$value + ")";
+			}
+		}
+
+		@java.lang.SuppressWarnings("all")
+		public static BuilderDefaultsGenericsInference.BuilderWithDefault.BuilderWithDefaultBuilder builder() {
+			return new BuilderDefaultsGenericsInference.BuilderWithDefault.BuilderWithDefaultBuilder();
+		}
+	}
+
+
+	public static class SuperBuilderWithDefault {
+		String foo;
+
+		@java.lang.SuppressWarnings("all")
+		private static String $default$foo() {
+			return doSth(MyClass.myInt(), MyClass.myChar());
+		}
+
+
+		@java.lang.SuppressWarnings("all")
+		public static abstract class SuperBuilderWithDefaultBuilder<C extends BuilderDefaultsGenericsInference.SuperBuilderWithDefault, B extends BuilderDefaultsGenericsInference.SuperBuilderWithDefault.SuperBuilderWithDefaultBuilder<C, B>> {
+			@java.lang.SuppressWarnings("all")
+			private boolean foo$set;
+			@java.lang.SuppressWarnings("all")
+			private String foo$value;
+
+			@java.lang.SuppressWarnings("all")
+			protected abstract B self();
+
+			@java.lang.SuppressWarnings("all")
+			public abstract C build();
+
+			/**
+			 * @return {@code this}.
+			 */
+			@java.lang.SuppressWarnings("all")
+			public B foo(final String foo) {
+				this.foo$value = foo;
+				foo$set = true;
+				return self();
+			}
+
+			@java.lang.Override
+			@java.lang.SuppressWarnings("all")
+			public java.lang.String toString() {
+				return "BuilderDefaultsGenericsInference.SuperBuilderWithDefault.SuperBuilderWithDefaultBuilder(foo$value=" + this.foo$value + ")";
+			}
+		}
+
+
+		@java.lang.SuppressWarnings("all")
+		private static final class SuperBuilderWithDefaultBuilderImpl extends BuilderDefaultsGenericsInference.SuperBuilderWithDefault.SuperBuilderWithDefaultBuilder<BuilderDefaultsGenericsInference.SuperBuilderWithDefault, BuilderDefaultsGenericsInference.SuperBuilderWithDefault.SuperBuilderWithDefaultBuilderImpl> {
+			@java.lang.SuppressWarnings("all")
+			private SuperBuilderWithDefaultBuilderImpl() {
+			}
+
+			@java.lang.Override
+			@java.lang.SuppressWarnings("all")
+			protected BuilderDefaultsGenericsInference.SuperBuilderWithDefault.SuperBuilderWithDefaultBuilderImpl self() {
+				return this;
+			}
+
+			@java.lang.Override
+			@java.lang.SuppressWarnings("all")
+			public BuilderDefaultsGenericsInference.SuperBuilderWithDefault build() {
+				return new BuilderDefaultsGenericsInference.SuperBuilderWithDefault(this);
+			}
+		}
+
+		@java.lang.SuppressWarnings("all")
+		protected SuperBuilderWithDefault(final BuilderDefaultsGenericsInference.SuperBuilderWithDefault.SuperBuilderWithDefaultBuilder<?, ?> b) {
+			if (b.foo$set) this.foo = b.foo$value;
+			 else this.foo = BuilderDefaultsGenericsInference.SuperBuilderWithDefault.$default$foo();
+		}
+
+		@java.lang.SuppressWarnings("all")
+		public static BuilderDefaultsGenericsInference.SuperBuilderWithDefault.SuperBuilderWithDefaultBuilder<?, ?> builder() {
+			return new BuilderDefaultsGenericsInference.SuperBuilderWithDefault.SuperBuilderWithDefaultBuilderImpl();
+		}
+	}
+
+
+	static class MyClass<T> {
+		final T value;
+
+		MyClass(T value) {
+			this.value = value;
+		}
+
+		static MyClass<Integer> myInt() {
+			return new MyClass<Integer>(42);
+		}
+
+		static MyClass<Character> myChar() {
+			return new MyClass<Character>('A');
+		}
+	}
+
+	static String doSth(MyClass<Integer> i, MyClass<Character> c) {
+		return i.value.toString() + c.value.toString();
+	}
+
+	public static void main(String[] args) {
+		if (!"42A".equals(BuilderWithDefault.builder().build().foo)) {
+			throw new AssertionError("Incorrect builder default");
+		}
+		if (!"42A".equals(SuperBuilderWithDefault.builder().build().foo)) {
+			throw new AssertionError("Incorrect super builder default");
+		}
+		if (!"custom".equals(BuilderWithDefault.builder().foo("custom").build().foo)) {
+			throw new AssertionError("Builder default overrides explicit value");
+		}
+		if (!"custom".equals(SuperBuilderWithDefault.builder().foo("custom").build().foo)) {
+			throw new AssertionError("Super builder default overrides explicit value");
+		}
+	}
+}
